{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Monkeysphere Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Monkeysphere.Web/bin/Debug/net10.0/Monkeysphere.Web.dll",
      "cwd": "${workspaceFolder}/src/Monkeysphere.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080",
        "MONKEYSPHERE_ADMIN_USERNAME": "admin",
        "MONKEYSPHERE_ADMIN_PASSWORD": "admin",
        "MONKEYSPHERE_DATA_ROOT": "${workspaceFolder}/.local/vscode-data",
        "DnaX__RemoteAccess__Enabled": "false"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
