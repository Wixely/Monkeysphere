{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "Monkeysphere.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "Monkeysphere.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "seed tag demo",
      "detail": "Adds tagged example records to the F5 data root (.local/vscode-data). Safe to re-run.",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "eng/SeedTagDemo.cs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "verify",
      "type": "shell",
      "command": ".\\eng\\Build.ps1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
}
