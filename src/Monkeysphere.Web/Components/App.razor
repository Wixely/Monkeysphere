<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <meta name="theme-color" content="#2a1b0c" />
    <script src="@Assets["theme.js"]"></script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["vendor/openlayers/10.10.0/ol.css"]" />
    <link rel="stylesheet" href="@Assets["Monkeysphere.Web.styles.css"]" />
    <ImportMap nonce="@ScriptNonce" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["vendor/openlayers/10.10.0/ol.js"]"></script>
    <script src="@Assets["vendor/cytoscape/3.34.0/cytoscape.min.js"]"></script>
    <script src="@Assets["combobox.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// The nonce the response header has already allowed. The import map is the one script this
    /// application does not serve as a file of its own, so it is the one that needs it.
    /// </summary>
    private string? ScriptNonce =>
        HttpContext?.Items.TryGetValue(Security.SecurityHeaders.NonceItemKey, out object? value) == true
            ? value as string
            : null;
}
