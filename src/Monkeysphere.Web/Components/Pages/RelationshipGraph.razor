@page "/graph"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IRelationshipGraphService GraphService
@inject IGraphViewService GraphViews
@inject IGraphSettingsService GraphSettings
@inject IMonkeysphereService Records
@inject IRecordTagCommandService Tagging
@inject IRecordTagStore TagVocabulary
@inject ITagCatalogue TagCatalogue
@inject IRelationshipService Relationships
@inject TimeProvider TimeProvider
@inject IRecordRelationshipCommandService Relating
@inject ICurrentDomain CurrentDomain
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Relationship graph · Monkeysphere</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<div class="page-heading">
    <div>
        <p class="eyebrow">Connections at a glance</p>
        <h1>Relationship graph</h1>
        <p>Browse everything, follow the connections around selected records, or compare only a chosen set.</p>
    </div>
    <div class="graph-view-selector">
        <label>
            Saved graph view
            <SearchableSelect TValue="string"
                              Value="CurrentGraphViewValue"
                              Options="GraphViewOptions"
                              AriaLabel="Saved graph view"
                              OnSelected="ChangeGraphViewAsync" />
        </label>
        <small>Select a saved filter and layout, or return to the default view.</small>
    </div>
</div>

<section class="panel graph-filters" aria-label="Graph filters">
    <div class="graph-filter-grid">
        <div>
            <label for="graph-record-search">Record name or alias</label>
            <div class="graph-search" @onfocusout="CloseSuggestionsAsync">
                <input id="graph-record-search"
                       type="text"
                       role="combobox"
                       placeholder="Type a name, or paste comma-separated names"
                       maxlength="500"
                       autocomplete="off"
                       aria-autocomplete="list"
                       aria-haspopup="listbox"
                       aria-expanded="@(_suggestions.Count > 0 ? "true" : "false")"
                       aria-controls="graph-search-options"
                       @oninput="SearchChangedAsync" />
                @if (_suggestions.Count > 0)
                {
                    <div class="combobox-list graph-search-options" id="graph-search-options" role="listbox" aria-label="Matching records">
                        @foreach (RecordSummary suggestion in _suggestions)
                        {
                            <button type="button"
                                    class="combobox-option"
                                    role="option"
                                    @onmousedown="() => SelectSuggestionAsync(suggestion)"
                                    @onmousedown:preventDefault>
                                <span>@suggestion.DisplayName</span>
                                <small>@suggestion.RecordTypeName</small>
                            </button>
                        }
                    </div>
                }
            </div>
            <small>Choose a result to centre it. Separate names with commas to choose several records.</small>
        </div>

        <fieldset class="graph-mode-picker">
            <legend>Show</legend>
            @foreach (RelationshipGraphDisplayMode mode in Enum.GetValues<RelationshipGraphDisplayMode>())
            {
                <label class="radio-label">
                    <input type="radio"
                           name="graph-display-mode"
                           value="@mode"
                           checked="@(_displayMode == mode)"
                           @onchange="() => ChangeModeAsync(mode)" />
                    @ModeLabel(mode)
                </label>
            }
        </fieldset>
    </div>

    @if (_selectedRecords.Count > 0)
    {
        <div class="graph-selected-records" aria-label="Selected records">
            @foreach (RecordSummary record in _selectedRecords)
            {
                <span class="filter-chip">
                    <button type="button" @onclick="() => CentreRecordAsync(record.Id)">@record.DisplayName</button>
                    <button type="button" class="filter-chip-remove" aria-label="Remove @record.DisplayName" @onclick="() => RemoveRecordAsync(record.Id)">×</button>
                </span>
            }
            <button class="text-button" type="button" @onclick="ClearSelectedAsync">Clear selected</button>
        </div>
    }

    @* The same control the calendar uses. The graph builds its view from a chosen set and saves
       it, so here choosing nothing means nothing rather than everything. *@
    <RecordTypePicker Types="_recordTypes" Selected="_selectedRecordTypeIds" EmptyMeansAll="false"
                      NameSelector="DisplayTypeName" SelectedChanged="RecordTypesChangedAsync" />
</section>

<section class="panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow">@ModeDescription()</p>
            <h2>@_graph.Nodes.Count nodes · @_graph.Edges.Count edges</h2>
        </div>
    </div>

    @* The fullscreen element. It is a wrapper rather than the canvas itself because the record
       centring combobox is the graph's only non-visual alternative and has to stay in the element
       that goes fullscreen. Fullscreen shows the graph and nothing else, so the controls sit over
       the canvas and the combobox is taken out of sight while staying focusable. *@
    <div class="graph-stage" @ref="_stage">
        @if (_graph.Nodes.Count == 0)
        {
            <p class="empty-state">@EmptyMessage()</p>
        }
        else
        {
            @if (_fullscreenMessage is not null)
            {
                <p class="notice" role="status">@_fullscreenMessage</p>
            }
            <p class="muted graph-stage-aside" id="relationship-graph-description">@GraphDescription</p>
            @* The frame exists to give the controls the canvas to sit over. Positioning them against
               the stage instead would land them on the description above the graph, and a row of
               their own would cost layout height and be the "top menu" fullscreen is meant to be
               free of. *@
            <div class="graph-canvas-frame">
                <div class="graph-stage-tools">
                    @if (_fullscreenAvailable)
                    {
                        <button class="graph-tool-button graph-fullscreen"
                                type="button"
                                aria-pressed="@(_fullscreen ? "true" : "false")"
                                aria-label="@FullscreenLabel"
                                title="@FullscreenLabel"
                                @onclick="ToggleFullscreenAsync"><span aria-hidden="true">&#x26F6;</span></button>
                    }
                    <button class="graph-tool-button graph-reset-viewport"
                            type="button"
                            aria-label="Reset viewport"
                            title="Reset viewport"
                            @onclick="ResetViewportAsync"><span aria-hidden="true">&#x2316;</span></button>
                </div>
                <RelationshipGraphCanvas @ref="_graphCanvas"
                                         Graph="_graph"
                                         NodePositions="_nodePositions"
                                         Viewport="_viewport"
                                         OnNodeSelected="SelectNode"
                                         OnGraphChanged="MarkGraphDirty"
                                         CenterRecordId="_centreRecordId"
                                         CenterRequest="_centreRequest"
                                         OnContextMenuRequested="OpenMenuAsync"
                                         OnContextMenuDismissed="CloseMenu"
                                         KeepRecordsApart="_graphConfiguration.KeepRecordsApart"
                                         Placement="_placement" />

                @if (_graph.NodesTruncated || _graph.EdgesTruncated)
                {
                    @* Over the canvas rather than above the panel. Said outside the stage it was
                       invisible in fullscreen, which is exactly where an operator is most likely to
                       believe they are looking at everything. Floating costs no layout height, so
                       it does not become the top menu fullscreen is meant to be free of. *@
                    <div class="graph-truncation-notice" role="status">
                        <span>
                            This view reached the @(_graph.NodesTruncated
                                ? $"{_graphConfiguration.NodeLimit:N0}-record"
                                : $"{_graphConfiguration.EdgeLimit:N0}-relationship") limit, so some of what matches is not drawn.
                        </span>
                        <a href="/settings/graph">Raise the limit</a>
                    </div>
                }

                @if (_picking && _pendingRelate is not null)
                {
                    <div class="graph-pick-banner" role="status">
                        <span>Click the record to relate <strong>@_pendingRelate.Description</strong> to.</span>
                        <button type="button" class="graph-context-menu-swap" @onclick="CancelPicking">Cancel</button>
                    </div>
                }

                @if (_pendingRelate is not null && _pickedTarget is not null)
                {
                    <div class="graph-pick-confirm" role="dialog" aria-modal="true"
                         aria-labelledby="graph-pick-title" @onkeydown="ConfirmKeyDownAsync">
                        <p class="eyebrow" id="graph-pick-title">Relate these records</p>
                        <p class="graph-context-menu-sentence">@PendingSentence</p>
                        <div class="graph-pick-actions">
                            <button class="button primary" type="button" autofocus
                                    @onclick="ConfirmPickAsync">@PendingConfirmLabel</button>
                            <button class="button" type="button" @onclick="CancelPicking">Cancel</button>
                        </div>
                    </div>
                }

                @if (_menu is not null)
                {
                    @* Inside the frame, not at page level. An overlay outside the fullscreen
                       element is invisible while the graph fills the screen, which is exactly how
                       the image gallery used to behave. *@
                    <div class="graph-context-menu" role="dialog" aria-label="@MenuLabel"
                         style="left: @(_menu.X)px; top: @(_menu.Y)px" @onkeydown="MenuKeyDownAsync">
                        <p class="graph-context-menu-title">@MenuLabel</p>

                        @if (_menu.RecordId is not null && _menu.RelationshipId is null)
                        {
                            <div class="graph-context-menu-tabs" role="tablist" aria-label="Record actions">
                                @foreach (MenuTab tab in Enum.GetValues<MenuTab>())
                                {
                                    <button type="button" role="tab" class="graph-context-menu-tab"
                                            id="@TabId(tab)"
                                            aria-selected="@(_menuTab == tab ? "true" : "false")"
                                            aria-controls="graph-menu-panel"
                                            tabindex="@(_menuTab == tab ? "0" : "-1")"
                                            @onclick="() => ChooseTabAsync(tab)"
                                            @onkeydown="args => TabKeyDownAsync(args, tab)">@TabLabel(tab)</button>
                                }
                            </div>
                        }

                        @if (_menu.RelationshipId is not null)
                        {
                            @* A menu asked for on a line is about that one relationship, so it has
                               no tabs: there is no record here to describe or to tag. *@
                            <div class="graph-context-menu-panel">
                                @RelationshipSection
                            </div>
                        }
                        else if (_menu.RecordId is null)
                        {
                            <p class="graph-context-menu-section" id="graph-menu-types">New record type</p>
                            <div class="graph-context-menu-list" role="group" aria-labelledby="graph-menu-types">
                                @foreach (RecordType type in RecentTypes)
                                {
                                    <button type="button"
                                            class="graph-context-menu-choice @(type.Id == _newRecordTypeId ? "chosen" : null)"
                                            aria-pressed="@(type.Id == _newRecordTypeId ? "true" : "false")"
                                            @onclick="() => ChooseTypeAsync(type.Id)">@DisplayTypeName(type)</button>
                                }
                            </div>
                            <label class="graph-context-menu-other">
                                Other type
                                <select value="@(_newRecordTypeId?.ToString("D") ?? string.Empty)"
                                        @onchange="OtherTypeChosenAsync">
                                    <option value="">Choose a type</option>
                                    @foreach (RecordType type in _recordTypes)
                                    {
                                        <option value="@type.Id.ToString("D")">@DisplayTypeName(type)</option>
                                    }
                                </select>
                            </label>
                            <label class="graph-context-menu-name">
                                Name
                                <input type="text" maxlength="200" placeholder="What is it called?"
                                       value="@_newRecordName" @oninput="NewRecordNameChanged" />
                            </label>
                            <button type="button" class="button primary graph-context-menu-create"
                                    disabled="@(!CanCreateRecord)" @onclick="CreateRecordAsync">Create record</button>
                        }
                        else
                        {
                            <div id="graph-menu-panel" role="tabpanel" aria-labelledby="@TabId(_menuTab)"
                                 class="graph-context-menu-panel">

                            @if (_menuTab == MenuTab.Info)
                            {
                                <dl class="graph-context-menu-facts">
                                    @if (MenuTargets.Count > 1)
                                    {
                                        <dt>Selected</dt>
                                        <dd>@MenuTargets.Count records</dd>
                                        <dt>Types</dt>
                                        <dd>@SelectedTypeSummary</dd>
                                    }
                                    else
                                    {
                                        <dt>Type</dt>
                                        <dd>@(SelectedNode?.RecordTypeName ?? "Unknown")</dd>
                                        @if (_menuRecord is not null)
                                        {
                                            <dt>Updated</dt>
                                            <dd>@_menuRecord.Record.UpdatedAtUtc.ToLocalTime().ToString("g")</dd>
                                            @if (_menuRecord.Aliases.Count > 0)
                                            {
                                                <dt>Also known as</dt>
                                                <dd>@string.Join(", ", _menuRecord.Aliases)</dd>
                                            }
                                            <dt>Images</dt>
                                            <dd>@_menuRecord.Images.Count</dd>
                                            <dt>Tags</dt>
                                            <dd>@_menuRecord.Tags.Count</dd>
                                        }
                                    }
                                </dl>
                                <a class="graph-context-menu-link" href="/records/@_menu.RecordId">Open record</a>
                            }

                            @if (_menuTab == MenuTab.Tags)
                            {
                            <p class="graph-context-menu-section" id="graph-menu-attached">@AttachedHeading</p>
                            @if (AttachedTags.Count == 0)
                            {
                                <p class="graph-context-menu-empty">@AttachedEmptyMessage</p>
                            }
                            else
                            {
                                <div class="graph-context-menu-list" role="group" aria-labelledby="graph-menu-attached">
                                    @foreach (string tag in AttachedTags)
                                    {
                                        <div class="graph-context-menu-tag attached">
                                            <button type="button" class="tag-apply add"
                                                    aria-label="@($"Add {tag} to {MenuTargetDescription}")"
                                                    title="@($"Add {tag}")"
                                                    @onclick="() => ApplyTagAsync(tag, add: true)">+</button>
                                            <button type="button" class="tag-apply remove"
                                                    aria-label="@($"Remove {tag} from {MenuTargetDescription}")"
                                                    title="@($"Remove {tag}")"
                                                    @onclick="() => ApplyTagAsync(tag, add: false)">&minus;</button>
                                            <span class="graph-context-menu-tag-name">@tag</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (PartlyHeldTags.Count > 0)
                            {
                                @* Named rather than hidden: with several records selected, a tag on
                                   some but not all of them is the case where "what do they have?"
                                   has no single answer, and quietly showing nothing would mislead. *@
                                <p class="graph-context-menu-empty">
                                    On some but not all: @string.Join(", ", PartlyHeldTags)
                                </p>
                            }

                            <p class="graph-context-menu-section" id="graph-menu-tags">Recently used</p>
                            <div class="graph-context-menu-list" role="group" aria-labelledby="graph-menu-tags">
                                @foreach (string tag in RecentTags)
                                {
                                    <div class="graph-context-menu-tag">
                                        <button type="button" class="tag-apply add"
                                                aria-label="@($"Add {tag} to {MenuTargetDescription}")"
                                                title="@($"Add {tag}")"
                                                @onclick="() => ApplyTagAsync(tag, add: true)">+</button>
                                        <button type="button" class="tag-apply remove"
                                                aria-label="@($"Remove {tag} from {MenuTargetDescription}")"
                                                title="@($"Remove {tag}")"
                                                @onclick="() => ApplyTagAsync(tag, add: false)">&minus;</button>
                                        <span class="graph-context-menu-tag-name">@tag</span>
                                    </div>
                                }
                            </div>
                            <div class="graph-context-menu-tag other">
                                <button type="button" class="tag-apply add"
                                        disabled="@string.IsNullOrEmpty(_otherTag)"
                                        aria-label="@($"Add the chosen tag to {MenuTargetDescription}")"
                                        title="Add the chosen tag"
                                        @onclick="() => ApplyTagAsync(_otherTag, add: true)">+</button>
                                <button type="button" class="tag-apply remove"
                                        disabled="@string.IsNullOrEmpty(_otherTag)"
                                        aria-label="@($"Remove the chosen tag from {MenuTargetDescription}")"
                                        title="Remove the chosen tag"
                                        @onclick="() => ApplyTagAsync(_otherTag, add: false)">&minus;</button>
                                <label class="graph-context-menu-other">
                                    <span class="visually-hidden">Other tag</span>
                                    <select value="@_otherTag" @onchange="OtherTagChosen">
                                        <option value="">Other tag...</option>
                                        @foreach (string tag in OtherTags)
                                        {
                                            <option value="@tag">@tag</option>
                                        }
                                    </select>
                                </label>
                            </div>
                            }

                            @if (_menuTab == MenuTab.Relationships)
                            {
                            @RelationshipSection

                            <p class="graph-context-menu-section" id="graph-menu-relate">Relate to a record</p>
                            <div class="graph-context-menu-relate" role="group" aria-labelledby="graph-menu-relate">
                                <div class="graph-context-menu-list">
                                    @foreach (RelationshipType type in RecentRelationshipTypes)
                                    {
                                        <button type="button"
                                                class="graph-context-menu-choice @(type.Id == _relationshipTypeId ? "chosen" : null)"
                                                aria-pressed="@(type.Id == _relationshipTypeId ? "true" : "false")"
                                                @onclick="() => ChooseRelationshipTypeAsync(type.Id)">@type.Name</button>
                                    }
                                </div>
                                <label class="graph-context-menu-other">
                                    Other relationship
                                    <select value="@(_relationshipTypeId?.ToString("D") ?? string.Empty)"
                                            @onchange="OtherRelationshipChosenAsync">
                                        <option value="">Choose a relationship</option>
                                        @foreach (RelationshipType type in _relationshipTypes)
                                        {
                                            <option value="@type.Id.ToString("D")">@type.Name</option>
                                        }
                                    </select>
                                </label>
                                <label class="checkbox-label graph-context-menu-expired">
                                    <input type="checkbox" @bind="_relateExpired" />
                                    <span>Already over</span>
                                </label>
                                @if (!_relateExpired)
                                {
                                    <label class="graph-context-menu-name">
                                        Ends on (optional)
                                        <input type="date" value="@_relateExpiresOn" @oninput="RelateExpiresChanged" />
                                    </label>
                                }
                                <button type="button" class="graph-context-menu-pick"
                                        disabled="@(_relationshipTypeId is null)"
                                        @onclick="StartPicking">Pick a record on the graph</button>
                                <label class="graph-context-menu-name">
                                    Or search for one
                                    <input type="text" maxlength="200" placeholder="Search every record"
                                           value="@_relateQuery" @oninput="RelateSearchAsync" />
                                </label>
                                @if (_relateSuggestions.Count > 0)
                                {
                                    <div class="graph-context-menu-list" role="group" aria-label="Matching records">
                                        @foreach (RecordSummary match in _relateSuggestions)
                                        {
                                            <button type="button" class="graph-context-menu-choice"
                                                    @onclick="() => ChooseRelateTarget(match)">@match.DisplayName <small>@match.RecordTypeName</small></button>
                                        }
                                    </div>
                                }
                                @if (_relateTarget is not null && _relationshipTypeId is not null)
                                {
                                    @* Spelled out as a sentence, because with a directional type the
                                       difference between the two readings is the whole meaning. *@
                                    <p class="graph-context-menu-sentence">@RelateSentence</p>
                                    @if (SelectedRelationshipType?.Directionality == RelationshipDirectionality.Directional)
                                    {
                                        <button type="button" class="graph-context-menu-swap"
                                                @onclick="() => _selectedAreSource = !_selectedAreSource">Swap direction</button>
                                    }
                                    <button type="button" class="button primary graph-context-menu-create"
                                            @onclick="RelateAsync">@RelateButtonLabel</button>
                                }
                            </div>

                            }
                            </div>
                        }

                        @if (_menuMessage is not null)
                        {
                            <p class="graph-context-menu-message" role="status">@_menuMessage</p>
                        }
                    </div>
                }
            </div>
            <label class="graph-record-picker graph-stage-aside">
                Centre a displayed record
                <SearchableSelect TValue="string" Value="@(_selected?.RecordId.ToString("D") ?? string.Empty)" Options="GraphNodeOptions" AriaLabel="Centre a displayed record" OnSelected="SelectNodeFromListAsync" />
            </label>
        }
    </div>
</section>

@if (_selected is not null)
{
    <section class="panel graph-selection" aria-live="polite">
        <div>
            <p class="eyebrow">Selected record</p>
            <h2>@_selected.DisplayName</h2>
            <p>@_selected.RecordTypeName</p>
        </div>
        <a class="button primary" href="/records/@_selected.RecordId">Open record</a>
    </section>
}

@if (_galleryOpen && _selected is not null)
{
    <div class="graph-gallery-overlay" @onclick="CloseGallery">
        <section class="graph-image-gallery"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="graph-gallery-title"
                 @onclick:stopPropagation
                 @onkeydown="HandleGalleryKeyDown">
            <div class="graph-gallery-heading">
                <div>
                    <p class="eyebrow">Record images</p>
                    <h2 id="graph-gallery-title">@_selected.DisplayName</h2>
                </div>
                <button class="graph-tool-button"
                        type="button"
                        aria-label="Close image gallery"
                        title="Close image gallery"
                        autofocus
                        @onclick="CloseGallery">&#x2715;</button>
            </div>

            @if (_galleryLoading)
            {
                <p class="empty-state" role="status">Loading images...</p>
            }
            else if (_galleryRecord is null || _galleryRecord.Images.Count == 0)
            {
                <div class="graph-gallery-empty">
                    <div class="record-image-placeholder" aria-hidden="true">@_selected.RecordTypeSymbol</div>
                    <p>No images are attached to this record.</p>
                </div>
            }
            else
            {
                RecordImage currentImage = _galleryRecord.Images[_galleryIndex];
                <figure class="graph-gallery-figure">
                    <div class="graph-gallery-stage">
                        @if (_galleryRecord.Images.Count > 1)
                        {
                            <button class="graph-gallery-step previous"
                                    type="button"
                                    aria-label="Previous image"
                                    @onclick="PreviousGalleryImage">&#x2039;</button>
                        }
                        <img src="/records/@currentImage.RecordId/images/@currentImage.Id/preview"
                             alt="@GalleryImageAlt(currentImage)" />
                        @if (_galleryRecord.Images.Count > 1)
                        {
                            <button class="graph-gallery-step next"
                                    type="button"
                                    aria-label="Next image"
                                    @onclick="NextGalleryImage">&#x203A;</button>
                        }
                    </div>
                    <figcaption>
                        <span>@(currentImage.Caption ?? currentImage.OriginalFileName)</span>
                        <small>Image @(_galleryIndex + 1) of @_galleryRecord.Images.Count</small>
                    </figcaption>
                </figure>

                @if (_galleryRecord.Images.Count > 1)
                {
                    <div class="graph-gallery-thumbnails" aria-label="Choose an image">
                        @for (int index = 0; index < _galleryRecord.Images.Count; index++)
                        {
                            int imageIndex = index;
                            RecordImage image = _galleryRecord.Images[imageIndex];
                            <button type="button"
                                    class="@(_galleryIndex == imageIndex ? "selected" : null)"
                                    aria-label="Show image @(imageIndex + 1)"
                                    aria-current="@(_galleryIndex == imageIndex ? "true" : null)"
                                    @onclick="() => ShowGalleryImage(imageIndex)">
                                <img src="/records/@image.RecordId/images/@image.Id/thumbnail"
                                     alt=""
                                     loading="lazy" />
                            </button>
                        }
                    </div>
                }
            }

            <div class="action-row graph-gallery-actions">
                <a class="button primary" href="/records/@_selected.RecordId">Open record</a>
                <button class="button" type="button" @onclick="CloseGallery">Close</button>
            </div>
        </section>
    </div>
}

<section class="panel graph-save-view">
    <div>
        <p class="eyebrow">Reusable graph filter</p>
        <h2>@(_editingGraphViewId.HasValue ? "Update graph view" : "Save graph view")</h2>
        <p class="muted">Stores the display mode, chosen records, visible record types, record positions, and viewport. Drag and zoom the graph before saving.</p>
        @if (_isDirty)
        {
            <span class="pill">Unsaved changes</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_saveMessage))
    {
        <div class="notice @(_saveError ? "error" : "success")" role="status">@_saveMessage</div>
    }
    <div class="graph-save-view-controls">
        <label>
            View name
            <input @bind="_graphViewName" @bind:after="MarkGraphDirty" maxlength="200" placeholder="For example, close family" />
        </label>
        <button class="button primary" type="button" @onclick="SaveGraphViewAsync">
            @(_editingGraphViewId.HasValue ? "Save changes" : "Save graph view")
        </button>
        @if (_editingGraphViewId.HasValue)
        {
            <button class="button" type="button" @onclick="NewGraphView">Save as new</button>
            @if (_confirmDeleteGraphView)
            {
                <button class="button danger" type="button" @onclick="DeleteGraphViewAsync">Confirm delete</button>
                <button class="button" type="button" @onclick="() => _confirmDeleteGraphView = false">Cancel</button>
            }
            else
            {
                <button class="button danger subtle" type="button" @onclick="() => _confirmDeleteGraphView = true">Delete</button>
            }
        }
        <a class="button" href="/structures/saved-views">Manage saved views</a>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "viewId")]
    public Guid? ViewId { get; set; }

    private IReadOnlyList<RecordType> _recordTypes = [];
    private IReadOnlyList<GraphView> _graphViews = [];
    private RelationshipGraphResult _graph = new([], [], false, false);
    private RelationshipGraphNode? _selected;
    private readonly List<RecordSummary> _selectedRecords = [];
    private IReadOnlyList<RecordSummary> _suggestions = [];
    private readonly HashSet<Guid> _selectedRecordTypeIds = [];
    private RelationshipGraphDisplayMode _displayMode = RelationshipGraphDisplayMode.All;
    private string _searchText = string.Empty;
    private Guid? _centreRecordId;
    private long _centreRequest;
    private long _searchRevision;
