    /// <summary>How many of each the menu offers before falling back to its dropdown.</summary>
    private const int RecentCount = 5;

    private string MenuLabel => _menu switch
    {
        { RelationshipId: not null } => $"Actions for {EdgeDescription}",
        { RecordId: null } => "Create a record here",
        _ => $"Actions for {MenuTargetDescription}",
    };

    /// <summary>The line the menu was asked for, when it was asked for on one rather than a record.</summary>
    private RelationshipGraphEdge? MenuEdge =>
        _menu?.RelationshipId is Guid id ? _graph.Edges.FirstOrDefault(edge => edge.RelationshipId == id) : null;

    /// <summary>
    /// A line read the way the graph draws it, source first. That order is the relationship's own
    /// rather than the operator's, which for a directional type is the difference between "works
    /// at" and "employs", so it is not reversed to suit whichever end was clicked nearer.
    /// </summary>
    private string EdgeDescription
    {
        get
        {
            if (MenuEdge is not RelationshipGraphEdge edge)
            {
                return "this relationship";
            }

            return $"{NodeName(edge.SourceRecordId)} — {edge.Label} — {NodeName(edge.TargetRecordId)}";
        }
    }

    private string NodeName(Guid recordId) =>
        _graph.Nodes.FirstOrDefault(node => node.RecordId == recordId)?.DisplayName ?? "a record";

    private string MenuTargetDescription
    {
        get
        {
            int count = _menu?.RecordIds.Count ?? 0;
            if (count > 1)
            {
                return $"{count} selected records";
            }

            Guid? id = _menu?.RecordId;
            return _graph.Nodes.FirstOrDefault(node => node.RecordId == id)?.DisplayName ?? "this record";
        }
    }

    private IReadOnlyList<Guid> MenuTargets =>
        _menu is null ? [] : _menu.RecordIds.Count > 0 ? _menu.RecordIds : _menu.RecordId is Guid one ? [one] : [];

    /// <summary>
    /// What the menu's records actually carry: one record's tags, or with several selected only
    /// the tags every one of them has. A tag on some but not all is reported separately, because
    /// "they share this" and "one of them has this" are different answers and the buttons here
    /// apply to all of them either way.
    /// </summary>
    private IReadOnlyList<string> AttachedTags
    {
        get
        {
            IReadOnlyList<Guid> targets = MenuTargets;
            if (targets.Count == 0)
            {
                return [];
            }

            IEnumerable<string>? shared = null;
            foreach (Guid id in targets)
            {
                IReadOnlyList<string> tags = _menuRecordTags.TryGetValue(id, out IReadOnlyList<string>? held) ? held : [];
                shared = shared is null ? tags : shared.Intersect(tags, StringComparer.OrdinalIgnoreCase);
            }

            return [.. (shared ?? []).OrderBy(tag => tag, StringComparer.CurrentCultureIgnoreCase)];
        }
    }

    private IReadOnlyList<string> PartlyHeldTags
    {
        get
        {
            if (MenuTargets.Count < 2)
            {
                return [];
            }

            HashSet<string> everywhere = new(AttachedTags, StringComparer.OrdinalIgnoreCase);
            return
            [
                .. MenuTargets
                    .SelectMany(id => _menuRecordTags.TryGetValue(id, out IReadOnlyList<string>? held) ? held : [])
                    .Where(tag => !everywhere.Contains(tag))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(tag => tag, StringComparer.CurrentCultureIgnoreCase),
            ];
        }
    }

    private string AttachedHeading => MenuTargets.Count > 1
        ? $"On all {MenuTargets.Count} selected"
        : "On this record";

    private string AttachedEmptyMessage => MenuTargets.Count > 1
        ? "No tag is on every selected record."
        : "No tags yet.";

    // Recently used first, then whatever else the catalogue offers, so the list is never empty on
    // a browser that has not been used for this yet. What the records already carry is shown above
    // instead, so it is not repeated here.
    private IReadOnlyList<string> RecentTags
    {
        get
        {
            HashSet<string> attached = new(AttachedTags, StringComparer.OrdinalIgnoreCase);
            return
            [
                .. _recentTags.Where(tag => _tagVocabulary.Contains(tag, StringComparer.OrdinalIgnoreCase))
                    .Concat(_tagVocabulary.Where(tag => !_recentTags.Contains(tag, StringComparer.OrdinalIgnoreCase)))
                    .Where(tag => !attached.Contains(tag))
                    .Take(RecentCount),
            ];
        }
    }

    private IReadOnlyList<string> OtherTags =>
        [.. _tagVocabulary
            .Where(tag => !RecentTags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            .Where(tag => !AttachedTags.Contains(tag, StringComparer.OrdinalIgnoreCase))];

    private IReadOnlyList<RecordType> RecentTypes =>
        [.. _recentTypeIds.Select(value => Guid.TryParse(value, out Guid id) ? id : Guid.Empty)
            .Select(id => _recordTypes.FirstOrDefault(type => type.Id == id))
            .Where(type => type is not null)
            .Concat(_recordTypes.Where(type => !_recentTypeIds.Contains(type.Id.ToString("D"), StringComparer.Ordinal)))
            .OfType<RecordType>()
            .Take(RecentCount)];

    private bool CanCreateRecord => _newRecordTypeId is not null && !string.IsNullOrWhiteSpace(_newRecordName);

    private RelationshipType? SelectedRelationshipType =>
        _relationshipTypes.FirstOrDefault(type => type.Id == _relationshipTypeId);

    private IReadOnlyList<RelationshipType> RecentRelationshipTypes =>
        [.. _recentRelationshipTypeIds.Select(value => Guid.TryParse(value, out Guid id) ? id : Guid.Empty)
            .Select(id => _relationshipTypes.FirstOrDefault(type => type.Id == id))
            .Where(type => type is not null)
            .Concat(_relationshipTypes.Where(type => !_recentRelationshipTypeIds.Contains(type.Id.ToString("D"), StringComparer.Ordinal)))
            .OfType<RelationshipType>()
            .Take(RecentCount)];

    /// <summary>
    /// The assignment as a sentence. A directional type reads one way from each end, so showing
    /// which one is about to be written is the difference between "works at" and "employs".
    /// </summary>
    private string RelateSentence
    {
        get
        {
            RelationshipType? type = SelectedRelationshipType;
            if (type is null || _relateTarget is null)
            {
                return string.Empty;
            }

            string label = type.Directionality == RelationshipDirectionality.Symmetric || _selectedAreSource
                ? type.Name
                : type.InverseName ?? type.Name;
            return $"{MenuTargetDescription} — {label} — {_relateTarget.DisplayName}{DescribeExpiry(RelateExpiry)}";
        }
    }

    private string PendingSentence
    {
        get
        {
            if (_pendingRelate is null || _pickedTarget is null)
            {
                return string.Empty;
            }

            RelationshipType? type = _relationshipTypes.FirstOrDefault(item => item.Id == _pendingRelate.RelationshipTypeId);
            string label = type is null || type.Directionality == RelationshipDirectionality.Symmetric || _pendingRelate.SelectedAreSource
                ? type?.Name ?? "related to"
                : type.InverseName ?? type.Name;
            return $"{_pendingRelate.Description} — {label} — {_pickedTarget.DisplayName}{DescribeExpiry(_pendingRelate.Expiry)}";
        }
    }

    private static string DescribeExpiry(RelationshipExpiry? expiry) => expiry switch
    {
        { Expired: true } => " (already over)",
        { ExpiresAtUtc: { } ends } => $" (until {ends.ToLocalTime():d})",
        _ => string.Empty,
    };

