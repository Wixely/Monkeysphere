    protected override async Task OnInitializedAsync()
    {
        _recordTypes = (await Records.ListRecordTypesAsync())
            .Where(type => type.Lifecycle == RecordTypeLifecycle.Active)
            .ToArray();
        _graphViews = await GraphViews.ListAsync();
        _graphConfiguration = await GraphSettings.GetAsync();
        _warnUnsavedChanges = _graphConfiguration.WarnUnsavedChanges;
        if (ViewId is Guid viewId)
        {
            await LoadGraphViewAsync(viewId);
        }
        else
        {
            _selectedRecordTypeIds.UnionWith(_recordTypes.Select(type => type.Id));
        }

        await ReloadAsync();
    }

    private Task ChangeGraphViewAsync(string value)
    {
        string destination = Guid.TryParse(value, out Guid viewId)
            ? $"/graph?viewId={viewId:D}"
            : "/graph";
        Navigation.NavigateTo(destination, forceLoad: true);
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _preferencesModule = await JS.InvokeAsync<IJSObjectReference>("import", "./graph-preferences.js");
            // The stage is rendered whether or not the view has any nodes, so registering
            // once here stays valid for the life of the page: a filter that empties the
            // graph does not take the fullscreen element away with it.
            _selfReference = DotNetObjectReference.Create(this);
            _fullscreenAvailable = await _preferencesModule.InvokeAsync<bool>("initFullscreen", _stage, _selfReference);
            if (_fullscreenAvailable)
            {
                StateHasChanged();
            }

            if (_editingGraphViewId.HasValue)
            {
                await SaveRecordTypePreferencesAsync();
            }
            else
            {
                string[]? savedIds = await _preferencesModule.InvokeAsync<string[]?>("loadRecordTypeIds", CurrentDomain.Id.ToString("D"));
                if (savedIds is not null)
                {
                    HashSet<Guid> available = _recordTypes.Select(type => type.Id).ToHashSet();
                    _selectedRecordTypeIds.Clear();
                    _selectedRecordTypeIds.UnionWith(savedIds
                        .Select(value => Guid.TryParse(value, out Guid id) ? id : Guid.Empty)
                        .Where(available.Contains));
                    await ReloadAsync();
                    StateHasChanged();
                }
            }
        }

        if (_preferencesModule is not null)
        {
            await _preferencesModule.InvokeVoidAsync("setUnsavedChanges", ShouldWarnAboutUnsavedChanges);
        }
    }

    private async Task SearchChangedAsync(ChangeEventArgs args)
    {
        long revision = ++_searchRevision;
        _searchText = args.Value?.ToString() ?? string.Empty;
        _searchDelay?.Cancel();
        _searchDelay?.Dispose();
        _searchDelay = new CancellationTokenSource();
        CancellationToken cancellationToken = _searchDelay.Token;
        try
        {
            await Task.Delay(300, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (revision != _searchRevision)
        {
            return;
        }

        string searchText = _searchText;
        string[] terms = searchText.Split(',', StringSplitOptions.TrimEntries);
        bool finalTermComplete = searchText.EndsWith(",", StringComparison.Ordinal);
        int completedCount = Math.Max(0, terms.Length - 1) + (finalTermComplete ? 1 : 0);
        bool changedSelection = false;
        for (int index = 0; index < Math.Min(completedCount, terms.Length); index++)
        {
            if (string.IsNullOrWhiteSpace(terms[index]))
            {
                continue;
            }

            IReadOnlyList<RecordSummary> matches = await SearchCandidatesAsync(terms[index]);
            if (matches.Count == 1)
            {
                changedSelection |= AddSelected(matches[0]);
            }
        }

        string current = finalTermComplete || terms.Length == 0 ? string.Empty : terms[^1];
        IReadOnlyList<RecordSummary> suggestions = string.IsNullOrWhiteSpace(current)
            ? []
            : await SearchCandidatesAsync(current);
        if (revision != _searchRevision)
        {
            return;
        }

        _suggestions = suggestions;
        if (suggestions.Count == 1 && current.Trim().Length >= 2)
        {
            changedSelection |= AddSelected(suggestions[0]);
            _suggestions = [];
            await ApplySelectionAsync(suggestions[0].Id);
        }
        else if (changedSelection && _displayMode != RelationshipGraphDisplayMode.All)
        {
            await ReloadAsync();
        }
    }

    private async Task<IReadOnlyList<RecordSummary>> SearchCandidatesAsync(string query)
    {
        string normalized = query.Trim();
        if (normalized.Length == 0 || _selectedRecordTypeIds.Count == 0)
        {
            return [];
        }

        List<RecordSummary> matches = [];
        foreach (Guid typeId in _selectedRecordTypeIds)
        {
            PagedResult<RecordSummary> result = await Records.SearchRecordsAsync(new(
                Query: normalized,
                RecordTypeId: typeId,
                PageSize: 8));
            matches.AddRange(result.Items);
        }

        return matches
            .DistinctBy(record => record.Id)
            .OrderBy(record => record.DisplayName, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(record => record.RecordTypeName, StringComparer.CurrentCultureIgnoreCase)
            .Take(8)
            .ToArray();
    }

    private async Task SelectSuggestionAsync(RecordSummary record)
    {
        AddSelected(record);
        _suggestions = [];
        await ApplySelectionAsync(record.Id);
    }

    private bool AddSelected(RecordSummary record)
    {
        if (_selectedRecords.Any(item => item.Id == record.Id))
        {
            return false;
        }

        if (_selectedRecords.Count >= RelationshipGraphService.MaximumSelectedRecords)
        {
            return false;
        }

        _selectedRecords.Add(record);
        _isDirty = true;
        return true;
    }

    private async Task ApplySelectionAsync(Guid recordId)
    {
        if (_displayMode != RelationshipGraphDisplayMode.All ||
            !_graph.Nodes.Any(node => node.RecordId == recordId))
        {
            await ReloadAsync();
        }

        await CentreRecordAsync(recordId);
    }

    private async Task ChangeModeAsync(RelationshipGraphDisplayMode mode)
    {
        _displayMode = mode;
        _selected = null;
        _isDirty = true;
        await ReloadAsync();
        if (_selectedRecords.Count == 1)
        {
            await CentreRecordAsync(_selectedRecords[0].Id);
        }
    }

    private async Task RecordTypesChangedAsync(IReadOnlySet<Guid> selected)
    {
        // The existing set is kept rather than replaced: saved views and the search candidates both
        // read it, and swapping the instance would leave them pointing at the old one.
        Guid[] added = selected.Except(_selectedRecordTypeIds).ToArray();
        Guid[] removed = _selectedRecordTypeIds.Except(selected).ToArray();
        foreach (Guid id in added.Concat(removed))
        {
            await ToggleRecordTypeAsync(id, new ChangeEventArgs { Value = selected.Contains(id) });
        }
    }

    private async Task ToggleRecordTypeAsync(Guid typeId, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _selectedRecordTypeIds.Add(typeId);
        }
        else
        {
            _selectedRecordTypeIds.Remove(typeId);
            _selectedRecords.RemoveAll(record => record.RecordTypeId == typeId);
        }

        _isDirty = true;
        if (_preferencesModule is not null)
        {
            await SaveRecordTypePreferencesAsync();
        }

        await ReloadAsync();
    }

    private async Task RemoveRecordAsync(Guid recordId)
    {
        if (_selectedRecords.RemoveAll(record => record.Id == recordId) > 0)
        {
            _isDirty = true;
        }
        _selected = null;
        if (_displayMode != RelationshipGraphDisplayMode.All)
        {
            await ReloadAsync();
        }
    }

    private async Task ClearSelectedAsync()
    {
        _isDirty |= _selectedRecords.Count > 0;
        _selectedRecords.Clear();
        _selected = null;
        _suggestions = [];
        if (_displayMode != RelationshipGraphDisplayMode.All)
        {
            await ReloadAsync();
        }
    }

    private async Task SelectNode(Guid recordId)
    {
        if (_picking && _pendingRelate is not null)
        {
            // The whole point of picking: this click names the other end, so it must not also
            // change the selection the assignment is about or open the gallery over the top of
            // the confirmation.
            RelationshipGraphNode? node = _graph.Nodes.FirstOrDefault(item => item.RecordId == recordId);
            if (node is not null)
            {
                _pickedTarget = new(node.RecordId, node.RecordTypeId, node.RecordTypeName, node.DisplayName, DateTimeOffset.UtcNow);
                _picking = false;
            }

            return;
        }

        _selected = _graph.Nodes.SingleOrDefault(node => node.RecordId == recordId);
        if (_selected is null)
        {
            return;
        }

        if (_fullscreen)
        {
            // Fullscreen shows the graph and nothing else, and the gallery is a page-level overlay
            // the fullscreen element does not contain. Opening it would display nothing now and
            // then ambush the operator with a modal the moment they left. Selecting the record is
            // the whole of the response here, and the canvas shows that itself.
            return;
        }

        long revision = ++_galleryRevision;
        _galleryOpen = true;
        _galleryLoading = true;
        _galleryRecord = null;
        _galleryIndex = 0;

        RecordDetails? details = await Records.GetRecordAsync(recordId);
        if (revision != _galleryRevision || !_galleryOpen)
        {
            return;
        }

        _galleryRecord = details;
        _galleryLoading = false;
        if (details is not null)
        {
            int coverIndex = details.Images.ToList().FindIndex(image => image.IsCover);
            _galleryIndex = Math.Max(0, coverIndex);
        }
    }

    private void CloseGallery()
    {
        _galleryRevision++;
        _galleryOpen = false;
        _galleryLoading = false;
        _galleryRecord = null;
        _galleryIndex = 0;
    }

    private void PreviousGalleryImage()
    {
        if (_galleryRecord is not null && _galleryRecord.Images.Count > 0)
        {
            _galleryIndex = (_galleryIndex - 1 + _galleryRecord.Images.Count) % _galleryRecord.Images.Count;
        }
    }

    private void NextGalleryImage()
    {
        if (_galleryRecord is not null && _galleryRecord.Images.Count > 0)
        {
            _galleryIndex = (_galleryIndex + 1) % _galleryRecord.Images.Count;
        }
    }

    private void ShowGalleryImage(int index)
    {
        if (_galleryRecord is not null && index >= 0 && index < _galleryRecord.Images.Count)
        {
            _galleryIndex = index;
        }
    }

    private void HandleGalleryKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Escape":
                CloseGallery();
                break;
            case "ArrowLeft":
                PreviousGalleryImage();
                break;
            case "ArrowRight":
                NextGalleryImage();
                break;
        }
    }

    private string GalleryImageAlt(RecordImage image) =>
        image.Caption ?? $"Image of {_selected?.DisplayName ?? "record"}";

    private async Task SelectNodeFromListAsync(string value)
    {
        if (Guid.TryParse(value, out Guid recordId))
        {
            await CentreRecordAsync(recordId);
        }
        else
        {
            _selected = null;
        }
    }

    private Task CentreRecordAsync(Guid recordId)
    {
        _selected = _graph.Nodes.SingleOrDefault(node => node.RecordId == recordId);
        if (_selected is not null)
        {
            _centreRecordId = recordId;
            _centreRequest++;
            _isDirty = true;
        }

        return Task.CompletedTask;
    }

    private Task CloseSuggestionsAsync()
    {
        _suggestions = [];
        return Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _graph = await GraphService.QueryAsync(new(
            DisplayMode: _displayMode,
            NodeLimit: _graphConfiguration.NodeLimit,
            EdgeLimit: _graphConfiguration.EdgeLimit,
            SelectedRecordIds: _selectedRecords.Select(record => record.Id).ToArray(),
            RecordTypeIds: _selectedRecordTypeIds.ToArray()));
        if (_selected is not null)
        {
            _selected = _graph.Nodes.SingleOrDefault(node => node.RecordId == _selected.RecordId);
        }
    }

    private async Task LoadGraphViewAsync(Guid id)
    {
        GraphView? view = await GraphViews.GetAsync(id);
        if (view is null)
        {
            _saveMessage = "Graph view was not found.";
            _saveError = true;
            _selectedRecordTypeIds.UnionWith(_recordTypes.Select(type => type.Id));
            return;
        }

        HashSet<Guid> availableTypeIds = _recordTypes.Select(type => type.Id).ToHashSet();
        _editingGraphViewId = view.Id;
        _graphViewName = view.Name;
        _displayMode = view.DisplayMode;
        _nodePositions = view.NodePositions;
        _viewport = view.Viewport;
        _selectedRecordTypeIds.UnionWith(view.RecordTypeIds.Where(availableTypeIds.Contains));
        foreach (Guid recordId in view.RecordIds)
        {
            RecordDetails? details = await Records.GetRecordAsync(recordId);
            if (details is not null && _selectedRecordTypeIds.Contains(details.Record.RecordTypeId))
            {
                _selectedRecords.Add(details.Record);
            }
        }
    }

    private async Task SaveGraphViewAsync()
    {
        try
        {
            IReadOnlyList<GraphViewNodePosition> positions = _graphCanvas is null
                ? []
                : await _graphCanvas.CaptureNodePositionsAsync();
            GraphViewViewport? viewport = _graphCanvas is null
                ? null
                : await _graphCanvas.CaptureViewportAsync();
            SaveGraphViewRequest request = new(
                _graphViewName,
                _displayMode,
                _selectedRecords.Select(record => record.Id).ToArray(),
                _selectedRecordTypeIds.ToArray(),
                positions,
                viewport);
            GraphView saved = _editingGraphViewId is Guid id
                ? await GraphViews.UpdateAsync(id, request)
                : await GraphViews.CreateAsync(request);
            _editingGraphViewId = saved.Id;
            _graphViewName = saved.Name;
            _nodePositions = saved.NodePositions;
            _viewport = saved.Viewport;
            _graphViews = await GraphViews.ListAsync();
            _saveMessage = $"Saved {saved.Name}.";
            _saveError = false;
            _confirmDeleteGraphView = false;
            _isDirty = false;
            Navigation.NavigateTo($"/graph?viewId={saved.Id:D}", replace: true);
        }
        catch (Exception exception) when (exception is DomainValidationException or InvalidOperationException)
        {
            _saveMessage = exception.Message;
            _saveError = true;
        }
    }

    private void NewGraphView()
    {
        _editingGraphViewId = null;
        _graphViewName = string.Empty;
        _saveMessage = "Enter a new name, then save this filter as another graph view.";
        _saveError = false;
        _isDirty = true;
        Navigation.NavigateTo("/graph", replace: true);
    }

    private async Task DeleteGraphViewAsync()
    {
        if (_editingGraphViewId is not Guid id || !await GraphViews.DeleteAsync(id))
        {
            _saveMessage = "Graph view was not found.";
            _saveError = true;
            return;
        }

        _editingGraphViewId = null;
        _graphViewName = string.Empty;
        _confirmDeleteGraphView = false;
        _graphViews = await GraphViews.ListAsync();
        _saveMessage = "Deleted graph view.";
        _saveError = false;
        _isDirty = false;
        Navigation.NavigateTo("/graph", replace: true);
    }

    private async Task ResetViewportAsync()
    {
        if (_graphCanvas is not null)
        {
            await _graphCanvas.ResetViewportAsync();
            _isDirty = true;
        }
    }

    private async Task ToggleFullscreenAsync()
    {
        if (_preferencesModule is null)
        {
            return;
        }

        // Nothing here sets _fullscreen. The browser reports what actually happened through
        // FullscreenChanged, so a refused request leaves the control saying what is true rather
        // than what was asked for.
        _fullscreenMessage = await _preferencesModule.InvokeAsync<bool>("toggleFullscreen")
            ? null
            : "This browser would not allow the graph to fill the screen.";
    }

    /// <summary>
    /// Called for every fullscreen transition, including the ones this page did not start:
    /// Escape, the browser's own control, or another element taking fullscreen away.
    /// </summary>
    [JSInvokable]
    public async Task FullscreenChanged(bool active)
    {
        if (active != _fullscreen && _graphCanvas is not null)
        {
            if (active)
            {
                // A graph framed for a panel leaves most of a screen empty, so fullscreen refits
                // it. Where the operator had it is remembered rather than thrown away, because
                // filling the screen is a way of looking at the graph, not a change to it.
                _viewportBeforeFullscreen = await _graphCanvas.CaptureViewportAsync();
                _adjustedInFullscreen = false;
                await _graphCanvas.FitAsync();
            }
            else if (!_adjustedInFullscreen)
            {
                // Only when they left the framing alone. Having moved the graph themselves, that
                // is the arrangement they meant to keep.
                await _graphCanvas.RestoreViewportAsync(_viewportBeforeFullscreen);
            }
        }

        _fullscreen = active;
        _fullscreenMessage = null;
        StateHasChanged();
    }

    private async Task OpenMenuAsync(RelationshipGraphCanvas.ContextMenuRequest request)
    {
        _menu = request;
        _menuMessage = null;
        _otherTag = string.Empty;
        _newRecordName = string.Empty;
        _newRecordTypeId = RecentTypes.FirstOrDefault()?.Id;

        // Read when the menu opens rather than carrying tags on every graph query. At 500 nodes
        // that would be a much larger response for something most graph loads never look at.
        _relateQuery = string.Empty;
        _relateSuggestions = [];
        _relateTarget = null;
        _selectedAreSource = true;
        _relateExpired = false;
        _relateExpiresOn = string.Empty;
        _editingRelationship = null;
        _confirmDeleteRelationshipId = null;
        _menuRelationships = [];
        _menuRelationshipTotal = 0;

        _tagVocabulary = await TagVocabulary.ListVocabularyAsync();
        _menuRecordTags = await TagVocabulary.ListForRecordsAsync(MenuTargets);
        _relationshipTypes = [.. (await Relationships.ListTypesAsync())
            .Where(type => type.Lifecycle == RelationshipLifecycle.Active)];
        if (_preferencesModule is not null)
        {
            string domain = CurrentDomain.Id.ToString("D");
            _recentTags = await _preferencesModule.InvokeAsync<string[]>("loadRecent", "tags", domain);
            _recentTypeIds = await _preferencesModule.InvokeAsync<string[]>("loadRecent", "types", domain);
            _recentRelationshipTypeIds = await _preferencesModule.InvokeAsync<string[]>("loadRecent", "relationships", domain);
            string remembered = await _preferencesModule.InvokeAsync<string>("loadSetting", "menu-tab", nameof(MenuTab.Info));
            _menuTab = Enum.TryParse(remembered, out MenuTab tab) ? tab : MenuTab.Info;
        }

        // A menu asked for on a line is about that line, so it opens on the tab that can act on
        // it and does not wait to be told which of three jobs it is for.
        if (_menu.RelationshipId is not null)
        {
            _menuTab = MenuTab.Relationships;
        }

        await LoadMenuRecordAsync();
        await LoadMenuRelationshipsAsync();

        // Right-clicking a line is already a choice of relationship, so its editor opens filled in
        // rather than making the operator find the same line again in a list.
        if (_menu.RelationshipId is Guid asked)
        {
            RelationshipView? picked = _menuRelationships.FirstOrDefault(view => view.Id == asked);
            if (picked is not null)
            {
                StartEditRelationship(picked);
            }
        }

        _relationshipTypeId = RecentRelationshipTypes.FirstOrDefault()?.Id;

        StateHasChanged();
    }

    private void CloseMenu()
    {
        _menu = null;
        _menuMessage = null;
    }

    private Task MenuKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseMenu();
        }

        return Task.CompletedTask;
    }

    private async Task ChooseTabAsync(MenuTab tab)
    {
        _menuTab = tab;
        if (_preferencesModule is not null)
        {
            await _preferencesModule.InvokeVoidAsync("saveSetting", "menu-tab", tab.ToString());
        }

        await LoadMenuRecordAsync();
        await LoadMenuRelationshipsAsync();
    }

    /// <summary>Left and right move between tabs, which is what a tablist is expected to do.</summary>
    private async Task TabKeyDownAsync(KeyboardEventArgs args, MenuTab tab)
    {
        MenuTab[] tabs = Enum.GetValues<MenuTab>();
        int index = Array.IndexOf(tabs, tab);
        int next = args.Key switch
        {
            "ArrowRight" => (index + 1) % tabs.Length,
            "ArrowLeft" => (index - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => index,
        };

        if (next != index)
        {
            await ChooseTabAsync(tabs[next]);
        }
    }

    /// <summary>
    /// Read only for the Info tab, and only for one record: it is the one part of the menu that
    /// wants more than the graph already carries, and fetching it for a selection of forty to
    /// show a count nobody asked for would be worse than not showing it.
    /// </summary>
    private async Task LoadMenuRecordAsync()
    {
        _menuRecord = _menuTab == MenuTab.Info && MenuTargets.Count == 1 && _menu?.RecordId is Guid id
            ? await Records.GetRecordAsync(id)
            : null;
    }

    /// <summary>How many of a record's relationships the menu lists before saying how many it did not.</summary>
    private const int MenuRelationshipCount = 8;

    /// <summary>
    /// The relationships that can be edited from here, read only when the Relationships tab is the
    /// one open. One record's, or the one line that was right-clicked: with several records selected
    /// there is no single answer to "which relationship", and listing forty records' worth of them
    /// would be a list nobody could act on.
    /// </summary>
    private async Task LoadMenuRelationshipsAsync()
    {
        if (_menuTab != MenuTab.Relationships || _menu is null)
        {
            _menuRelationships = [];
            _menuRelationshipTotal = 0;
            return;
        }

        // A line names its own two ends, so the read is anchored on one of them; otherwise it is
        // the one record the menu is for.
        Guid? anchor = MenuEdge?.SourceRecordId ?? (MenuTargets.Count == 1 ? _menu.RecordId : null);
        if (anchor is not Guid recordId)
        {
            _menuRelationships = [];
            _menuRelationshipTotal = 0;
            return;
        }

        PagedResult<RelationshipView> page = await Relationships.QueryForRecordAsync(
            recordId, page: 1, pageSize: MenuRelationshipCount);
        _menuRelationships = page.Items;
        _menuRelationshipTotal = page.TotalCount;

        // The line that was right-clicked may sit past the first page, and a menu opened on it that
        // then could not show it would be worse than a longer read.
        if (_menu.RelationshipId is Guid asked && _menuRelationships.All(view => view.Id != asked))
        {
            IReadOnlyList<RelationshipView> all = await Relationships.ListForRecordAsync(recordId);
            if (all.FirstOrDefault(view => view.Id == asked) is RelationshipView found)
            {
                _menuRelationships = [found, .. _menuRelationships];
            }
        }
    }

    /// <summary>
    /// Fills the editor from what the relationship is now. Its revision comes with it, which is
    /// what makes saving refuse to overwrite a change somebody else made in the meantime.
    /// </summary>
    private void StartEditRelationship(RelationshipView view)
    {
        _editingRelationship = view;
        _confirmDeleteRelationshipId = null;
        _menuMessage = null;
        _editRelationshipTypeId = view.RelationshipTypeId;
        _editNote = view.Note ?? string.Empty;
        _editExpired = view.Expiry.Expired;
        _editExpiresOn = view.Expiry is { Expired: false, ExpiresAtUtc: { } ends }
            ? ends.ToLocalTime().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            : string.Empty;
    }

    private void CancelEditRelationship()
    {
        _editingRelationship = null;
        _editRelationshipTypeId = null;
        _editNote = string.Empty;
        _editExpired = false;
        _editExpiresOn = string.Empty;
    }

    private void EditNoteChanged(ChangeEventArgs args) => _editNote = args.Value?.ToString() ?? string.Empty;

    private void EditExpiresChanged(ChangeEventArgs args) => _editExpiresOn = args.Value?.ToString() ?? string.Empty;

    private void EditRelationshipTypeChosen(ChangeEventArgs args) =>
        _editRelationshipTypeId = Guid.TryParse(args.Value?.ToString(), out Guid id) ? id : null;

    /// <summary>
    /// What the editor is saying about this relationship's ending, in the same shape the creation
    /// form uses: said outright, or a date, never both.
    /// </summary>
    private RelationshipExpiry EditExpiry => _editExpired
        ? new(Expired: true)
        : DateOnly.TryParse(_editExpiresOn, CultureInfo.InvariantCulture, out DateOnly ends)
            ? new(Expired: false, ends.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Utc))
            : RelationshipExpiry.None;

    /// <summary>
    /// Changes the relationship in place rather than replacing it. Deleting and recreating would
    /// give a different relationship with a new ID, and anything already holding the old one would
    /// silently lose it.
    /// </summary>
    private async Task SaveRelationshipAsync()
    {
        if (_editingRelationship is not RelationshipView editing || _editRelationshipTypeId is not Guid typeId)
        {
            return;
        }

        try
        {
            _ = await Relationships.UpdateAsync(
                editing.Id, typeId, _editNote, PerspectiveRecordId(), editing.Revision, EditExpiry);
            _menuMessage = $"Saved {DescribeRelationship(editing)}.";
            await RememberRecentAsync("relationships", typeId.ToString("D"));
            CancelEditRelationship();
            await ReloadAsync();
            await LoadMenuRelationshipsAsync();
            _isDirty = true;
        }
        catch (ConcurrencyConflictException exception)
        {
            // The editor closes rather than staying open against a revision that no longer exists:
            // the operator has to see what changed before deciding what to do about it.
            _menuMessage = exception.Message;
            CancelEditRelationship();
            await LoadMenuRelationshipsAsync();
        }
        catch (DomainValidationException exception)
        {
            _menuMessage = exception.Message;
        }
        catch (RecordCommandNotFoundException exception)
        {
            _menuMessage = exception.Message;
            CancelEditRelationship();
            await LoadMenuRelationshipsAsync();
        }
    }

    /// <summary>
    /// Closes the editor, the way starting an edit closes this. Two forms open on one relationship
    /// at once, one of them asking whether to keep it, is a question about which of them matters.
    /// </summary>
    private void AskDeleteRelationship(Guid relationshipId)
    {
        CancelEditRelationship();
        _confirmDeleteRelationshipId = relationshipId;
        _menuMessage = null;
    }

    private void CancelDeleteRelationship() => _confirmDeleteRelationshipId = null;

    /// <summary>
    /// Deletion is for a relationship that should never have existed. One that has ended is a
    /// different thing and is said with expiry instead, which is why the two sit side by side here
    /// rather than deleting being the only way to stop a relationship being true.
    /// </summary>
    private async Task DeleteRelationshipAsync(RelationshipView view)
    {
        try
        {
            bool deleted = await Relationships.DeleteAsync(view.Id, view.Revision);
            _menuMessage = deleted
                ? $"Deleted {DescribeRelationship(view)}."
                : "That relationship was already gone.";
            _confirmDeleteRelationshipId = null;
            CancelEditRelationship();
            await ReloadAsync();
            await LoadMenuRelationshipsAsync();
            _isDirty = true;
        }
        catch (ConcurrencyConflictException exception)
        {
            _menuMessage = exception.Message;
            _confirmDeleteRelationshipId = null;
            await LoadMenuRelationshipsAsync();
        }
    }

    /// <summary>
    /// Which end the change is being made from. It only chooses how the saved relationship reads
    /// back, so the message about it matches the wording the operator was just looking at.
    /// </summary>
    private Guid PerspectiveRecordId() =>
        MenuEdge?.SourceRecordId ?? _menu?.RecordId ?? Guid.Empty;

    private static string DescribeRelationship(RelationshipView view) =>
        $"“{view.Label} {view.RelatedDisplayName}”";

    /// <summary>
    /// A relationship as one line. Whether its date has passed is decided against the same clock
    /// the graph used to decide what to draw faded, so a line described as still running here is
    /// never one the canvas has already faded out.
    /// </summary>
    private string RelationshipRowSummary(RelationshipView view)
    {
        DateTimeOffset now = TimeProvider.GetUtcNow();
        string ending = view.Expiry switch
        {
            { Expired: true } => " — over",
            { ExpiresAtUtc: { } ends } when ends <= now => $" — ended {ends.ToLocalTime():d}",
            { ExpiresAtUtc: { } ends } => $" — until {ends.ToLocalTime():d}",
            _ => string.Empty,
        };

        return $"{view.Label} {view.RelatedDisplayName}{ending}";
    }

    private string MenuRelationshipHeading => _menu?.RelationshipId is not null
        ? "This relationship"
        : _menuRelationshipTotal > _menuRelationships.Count
            ? $"Existing relationships ({_menuRelationships.Count} of {_menuRelationshipTotal})"
            : "Existing relationships";

    /// <summary>
    /// The relationships this menu can act on. A menu asked for on a line shows that line alone:
    /// the pointer already chose, and offering the other seven would be asking again.
    /// </summary>
    private IReadOnlyList<RelationshipView> MenuRelationshipRows =>
        _menu?.RelationshipId is Guid asked
            ? [.. _menuRelationships.Where(view => view.Id == asked)]
            : _menuRelationships;

    private string MenuRelationshipEmpty => _menu?.RelationshipId is not null
        ? "That relationship is no longer here."
        : "No relationships yet.";

    /// <summary>
    /// Editing and ending existing relationships, shared by the Relationships tab and by the menu a
    /// right-clicked line opens. One markup for both, because they are the same job reached two
    /// ways, and two copies would drift.
    /// </summary>
    private RenderFragment RelationshipSection => @<text>
        <p class="graph-context-menu-section" id="graph-menu-existing">@MenuRelationshipHeading</p>
        @if (MenuRelationshipRows.Count == 0)
        {
            <p class="graph-context-menu-empty">@MenuRelationshipEmpty</p>
        }
        else
        {
            <div class="graph-context-menu-relationships" role="group" aria-labelledby="graph-menu-existing">
                @foreach (RelationshipView view in MenuRelationshipRows)
                {
                    <div class="graph-context-menu-relationship @(view.Expiry.IsExpiredAt(TimeProvider.GetUtcNow()) ? "over" : null)">
                        <span class="graph-context-menu-relationship-name">@RelationshipRowSummary(view)</span>
                        <button type="button" class="graph-context-menu-swap"
                                aria-label="@($"Edit {view.Label} {view.RelatedDisplayName}")"
                                @onclick="() => StartEditRelationship(view)">Edit</button>
                        <button type="button" class="graph-context-menu-danger"
                                aria-label="@($"Delete {view.Label} {view.RelatedDisplayName}")"
                                @onclick="() => AskDeleteRelationship(view.Id)">Delete</button>
                    </div>

                    @if (_confirmDeleteRelationshipId == view.Id)
                    {
                        @* Asked before doing, because this is the one action here that loses
                           something. A relationship that has merely ended is said with "Already
                           over" instead, which the editor below offers. *@
                        <div class="graph-context-menu-confirm" role="group"
                             aria-label="@($"Delete {view.Label} {view.RelatedDisplayName}?")">
                            <p>Delete this relationship? If it has simply ended, mark it over instead.</p>
                            <div class="graph-pick-actions">
                                <button type="button" class="graph-context-menu-danger" autofocus
                                        @onclick="() => DeleteRelationshipAsync(view)">Delete it</button>
                                <button type="button" class="graph-context-menu-swap"
                                        @onclick="CancelDeleteRelationship">Keep it</button>
                            </div>
                        </div>
                    }

                    @if (_editingRelationship?.Id == view.Id)
                    {
                        <div class="graph-context-menu-edit" role="group"
                             aria-label="@($"Edit {view.Label} {view.RelatedDisplayName}")">
                            <label class="graph-context-menu-other">
                                Relationship
                                <select value="@(_editRelationshipTypeId?.ToString("D") ?? string.Empty)"
                                        @onchange="EditRelationshipTypeChosen">
                                    @foreach (RelationshipType type in _relationshipTypes)
                                    {
                                        <option value="@type.Id.ToString("D")">@type.Name</option>
                                    }
                                </select>
                            </label>
                            <label class="graph-context-menu-name">
                                Note
                                <input type="text" maxlength="2000" placeholder="Why are they related?"
                                       value="@_editNote" @oninput="EditNoteChanged" />
                            </label>
                            <label class="checkbox-label graph-context-menu-expired">
                                <input type="checkbox" @bind="_editExpired" />
                                <span>Already over</span>
                            </label>
                            @if (!_editExpired)
                            {
                                <label class="graph-context-menu-name">
                                    Ends on (optional)
                                    <input type="date" value="@_editExpiresOn" @oninput="EditExpiresChanged" />
                                </label>
                            }
                            <div class="graph-pick-actions">
                                <button type="button" class="button primary"
                                        disabled="@(_editRelationshipTypeId is null)"
                                        @onclick="SaveRelationshipAsync">Save relationship</button>
                                <button type="button" class="graph-context-menu-swap"
                                        @onclick="CancelEditRelationship">Cancel</button>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </text>;

    private void OtherTagChosen(ChangeEventArgs args) => _otherTag = args.Value?.ToString() ?? string.Empty;

    private void NewRecordNameChanged(ChangeEventArgs args) => _newRecordName = args.Value?.ToString() ?? string.Empty;

    private Task ChooseTypeAsync(Guid typeId)
    {
        _newRecordTypeId = typeId;
        return Task.CompletedTask;
    }

    private Task OtherTypeChosenAsync(ChangeEventArgs args)
    {
        _newRecordTypeId = Guid.TryParse(args.Value?.ToString(), out Guid id) ? id : null;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Applies one tag to everything the menu is acting on, regardless of what each record carried
    /// before. No expected revision goes with it deliberately: adding or removing one named tag
    /// cannot overwrite somebody else's concurrent change the way a whole-record save could, so a
    /// revision check here would refuse work without preventing any loss.
    /// </summary>
    private async Task ApplyTagAsync(string tag, bool add)
    {
        if (_menu is null || string.IsNullOrWhiteSpace(tag))
        {
            return;
        }

        IReadOnlyList<Guid> targets = _menu.RecordIds.Count > 0
            ? _menu.RecordIds
            : _menu.RecordId is Guid single ? [single] : [];
        if (targets.Count == 0)
        {
            return;
        }

        try
        {
            IReadOnlyList<RecordTagChange> changes = await Tagging.ApplyAsync(new(
                [.. targets.Select(id => new RecordTagSelection(id))],
                Add: add ? [tag] : null,
                Remove: add ? null : [tag]));
            _menuMessage = DescribeTagResult(tag, add, changes);
            await RememberRecentAsync("tags", tag);
            // Re-read rather than patch: what the menu shows about these records has to be what
            // they now hold, including the ones the change did not apply to.
            _menuRecordTags = await TagVocabulary.ListForRecordsAsync(targets);
            _tagVocabulary = await TagVocabulary.ListVocabularyAsync();
            await ReloadAsync();
        }
        catch (DomainValidationException exception)
        {
            _menuMessage = exception.Message;
        }
    }

    private static string DescribeTagResult(string tag, bool add, IReadOnlyList<RecordTagChange> changes)
    {
        int changed = changes.Count(change => change.Outcome == RecordTagOutcome.Applied);
        int already = changes.Count(change => change.Outcome == RecordTagOutcome.Unchanged);
        int refused = changes.Count(change => change.Outcome == RecordTagOutcome.TagsDisabled);
        string verb = add ? "Added" : "Removed";
        string preposition = add ? "to" : "from";
        List<string> parts = [$"{verb} {tag} {preposition} {changed} record{(changed == 1 ? string.Empty : "s")}"];
        if (already > 0)
        {
            parts.Add($"{already} already {(add ? "had" : "lacked")} it");
        }

        // Named rather than folded into the count: a record whose type has no tags did not take
        // the change, and reporting it as done would be untrue.
        if (refused > 0)
        {
            parts.Add($"{refused} cannot carry tags");
        }

        return string.Join("; ", parts) + ".";
    }

    private async Task CreateRecordAsync()
    {
        if (_menu is null || _newRecordTypeId is not Guid typeId || string.IsNullOrWhiteSpace(_newRecordName))
        {
            return;
        }

        if (_graph.NodesTruncated)
        {
            // The view is already showing everything it will draw, so a new record would be
            // created and then not appear, which reads as a failure.
            _menuMessage = "This view is already at its record limit, so a new record would not appear. Narrow the view or raise the limit in graph settings first.";
            return;
        }

        try
        {
            RecordDetails created = await Records.CreateRecordAsync(typeId, _newRecordName.Trim(), []);
            await RememberRecentAsync("types", typeId.ToString("D"));

            // Roughly where they right-clicked. Roughly, because spacing may still nudge it clear
            // of a record already sitting there unless that has been turned off.
            _placement = new(created.Record.Id.ToString("D"), _menu.X, _menu.Y, ++_placementRequest);

            // Added to the selected set so it is displayed whatever the current filter is, which
            // is the only way a newly created record is guaranteed to be visible at all.
            _selectedRecords.Add(created.Record);
            await ReloadAsync();
            _menuMessage = $"Created {created.Record.DisplayName}.";
            _newRecordName = string.Empty;
            _isDirty = true;
        }
        catch (DomainValidationException exception)
        {
            _menuMessage = exception.Message;
        }
    }

    private Task ChooseRelationshipTypeAsync(Guid typeId)
    {
        _relationshipTypeId = typeId;
        return Task.CompletedTask;
    }

    private Task OtherRelationshipChosenAsync(ChangeEventArgs args)
    {
        _relationshipTypeId = Guid.TryParse(args.Value?.ToString(), out Guid id) ? id : null;
        return Task.CompletedTask;
    }

    private void RelateExpiresChanged(ChangeEventArgs args) =>
        _relateExpiresOn = args.Value?.ToString() ?? string.Empty;

    /// <summary>
    /// What the form is saying about the end of this relationship. "Already over" wins outright,
    /// which is why the date is not offered alongside it: the two together could only disagree.
    /// </summary>
    private RelationshipExpiry? RelateExpiry
    {
        get
        {
            if (_relateExpired)
            {
                return new(Expired: true);
            }

            return DateOnly.TryParse(_relateExpiresOn, CultureInfo.InvariantCulture, out DateOnly ends)
                // End of that day rather than its first instant, so a relationship ending today is
                // still true today.
                ? new(Expired: false, ends.ToDateTime(TimeOnly.MaxValue, DateTimeKind.Utc))
                : null;
        }
    }

    private void ChooseRelateTarget(RecordSummary record)
    {
        _relateTarget = record;
        _relateQuery = record.DisplayName;
        _relateSuggestions = [];
    }

    /// <summary>
    /// Searches every record rather than only the types the view is filtered to. The record being
    /// related to is very often one the graph is not currently showing: a workplace, when what is
    /// on screen is people.
    /// </summary>
    private async Task RelateSearchAsync(ChangeEventArgs args)
    {
        long revision = ++_relateRevision;
        _relateQuery = args.Value?.ToString() ?? string.Empty;
        _relateTarget = null;
        string query = _relateQuery.Trim();
        if (query.Length < 2)
        {
            _relateSuggestions = [];
            return;
        }

        PagedResult<RecordSummary> matches = await Records.SearchRecordsAsync(new(query));
        if (revision != _relateRevision)
        {
            return;
        }

        _relateSuggestions = [.. matches.Items.Take(RecentCount)];
    }

    /// <summary>
    /// Hands the assignment over to the canvas: the menu closes so the graph is visible and
    /// clickable, and the next record clicked becomes the other end rather than a selection.
    /// </summary>
    private void StartPicking()
    {
        if (_menu is null || _relationshipTypeId is not Guid typeId || MenuTargets.Count == 0)
        {
            return;
        }

        _pendingRelate = new(MenuTargets, MenuTargetDescription, typeId, _selectedAreSource, RelateExpiry);
        _pickedTarget = null;
        _picking = true;
        _menu = null;
    }

    private void CancelPicking()
    {
        _picking = false;
        _pendingRelate = null;
        _pickedTarget = null;
    }

    private Task ConfirmKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelPicking();
        }

        return Task.CompletedTask;
    }

    private async Task ConfirmPickAsync()
    {
        if (_pendingRelate is not PendingRelate pending || _pickedTarget is null)
        {
            return;
        }

        try
        {
            IReadOnlyList<RecordRelationshipChange> changes = await Relating.ApplyAsync(new(
                pending.RecordIds, pending.RelationshipTypeId, _pickedTarget.Id, pending.SelectedAreSource,
                Expiry: pending.Expiry));
            _menuMessage = DescribeRelateResult(changes, _pickedTarget.DisplayName);
            await RememberRecentAsync("relationships", pending.RelationshipTypeId.ToString("D"));
            await ReloadAsync();
            _isDirty = true;
        }
        catch (DomainValidationException exception)
        {
            _menuMessage = exception.Message;
        }
        catch (RecordCommandNotFoundException exception)
        {
            _menuMessage = exception.Message;
        }

        CancelPicking();
    }

    private async Task RelateAsync()
    {
        if (_relateTarget is null || _relationshipTypeId is not Guid typeId)
        {
            return;
        }

        IReadOnlyList<Guid> targets = MenuTargets;
        if (targets.Count == 0)
        {
            return;
        }

        try
        {
            IReadOnlyList<RecordRelationshipChange> changes = await Relating.ApplyAsync(new(
                targets, typeId, _relateTarget.Id, _selectedAreSource, Expiry: RelateExpiry));
            _menuMessage = DescribeRelateResult(changes, _relateTarget.DisplayName);
            await RememberRecentAsync("relationships", typeId.ToString("D"));
            await ReloadAsync();
            // The list above this form has just become wrong, and a menu still saying "no
            // relationships yet" under a message announcing one is worse than not listing them.
            await LoadMenuRelationshipsAsync();
            _isDirty = true;
        }
        catch (DomainValidationException exception)
        {
            _menuMessage = exception.Message;
        }
        catch (RecordCommandNotFoundException exception)
        {
            _menuMessage = exception.Message;
        }
    }

    private static string DescribeRelateResult(IReadOnlyList<RecordRelationshipChange> changes, string otherName)
    {
        int created = changes.Count(change => change.Outcome == RecordRelationshipOutcome.Created);
        int already = changes.Count(change => change.Outcome == RecordRelationshipOutcome.AlreadyRelated);
        int itself = changes.Count(change => change.Outcome == RecordRelationshipOutcome.SameRecord);
        List<string> parts = [$"Related {created} record{(created == 1 ? string.Empty : "s")} to {otherName}"];
        if (already > 0)
        {
            parts.Add($"{already} already were");
        }

        // Named rather than counted as done: relating a record to itself is not something that
        // happened, and an operator who selected the far end should be told.
        if (itself > 0)
        {
            parts.Add($"{itself} is that record");
        }

        return string.Join("; ", parts) + ".";
    }

    private async Task RememberRecentAsync(string kind, string value)
    {
        if (_preferencesModule is null)
        {
            return;
        }

        string[] next = await _preferencesModule.InvokeAsync<string[]>(
            "rememberRecent", kind, CurrentDomain.Id.ToString("D"), value, RecentCount);
        switch (kind)
        {
            case "tags": _recentTags = next; break;
            case "relationships": _recentRelationshipTypeIds = next; break;
            default: _recentTypeIds = next; break;
        }
    }

    private Task MarkGraphDirty()
    {
        _isDirty = true;
        if (_fullscreen)
        {
            _adjustedInFullscreen = true;
        }

        return Task.CompletedTask;
    }

    private bool ShouldWarnAboutUnsavedChanges => _warnUnsavedChanges && _isDirty;

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!ShouldWarnAboutUnsavedChanges || _allowNavigation)
        {
            return;
        }

        context.PreventNavigation();
        bool leave = await JS.InvokeAsync<bool>(
            "confirm",
            "You have unsaved graph changes. Leave this page and discard them?");
        if (leave)
        {
            _allowNavigation = true;
            Navigation.NavigateTo(context.TargetLocation);
        }
    }

    private async Task SaveRecordTypePreferencesAsync()
    {
        if (_preferencesModule is not null)
        {
            string[] ids = _selectedRecordTypeIds.Select(id => id.ToString("D")).ToArray();
            await _preferencesModule.InvokeVoidAsync(
                "saveRecordTypeIds",
                new object?[] { CurrentDomain.Id.ToString("D"), ids });
        }
    }

    private string ModeDescription() => _displayMode switch
    {
        RelationshipGraphDisplayMode.Connected => "Selected records and their connections",
        RelationshipGraphDisplayMode.Isolated => "Selected records only",
        _ => "Everything in the selected record types",
    };

    private string EmptyMessage() => _displayMode != RelationshipGraphDisplayMode.All && _selectedRecords.Count == 0
        ? "Choose one or more records above to build this graph view."
        : "No records match this graph view.";

    private static string ModeLabel(RelationshipGraphDisplayMode mode) => mode switch
    {
        RelationshipGraphDisplayMode.Connected => "Show connected",
        RelationshipGraphDisplayMode.Isolated => "Show isolated",
        _ => "Show all",
    };

    private static string DisplayTypeName(RecordType type) =>
        string.Equals(type.PresetKey, "monkeysphere.person", StringComparison.Ordinal) ? "People" : type.Name;

    public async ValueTask DisposeAsync()
    {
        _searchDelay?.Cancel();
        _searchDelay?.Dispose();
        if (_preferencesModule is not null)
        {
            try
            {
                await _preferencesModule.InvokeVoidAsync("clearUnsavedChanges");
                await _preferencesModule.InvokeVoidAsync("disposeFullscreen");
                await _preferencesModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
