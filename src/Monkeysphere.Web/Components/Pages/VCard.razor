@page "/vcard"
@page "/settings"
@page "/settings/import-export"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IVCardService VCards
@inject IMonkeysphereService Records
@inject ContactPhotoImporter ContactPhotos
@inject ContactPhotoFetcher PhotoFetcher
@inject IContactEnrichmentBackfill Backfill

<PageTitle>Import and export · Monkeysphere</PageTitle>

<SettingsTabs Active="import-export" />

<div class="page-heading">
    <div>
        <p class="eyebrow">Portable contacts</p>
        <h1>vCard import and export</h1>
        <p>Preview one-time vCard 3.0 or 4.0 imports, resolve duplicates explicitly, and export selected people as vCard 4.0.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "error" : "success")" role="status">@_message</div>
}

<div class="split-layout vcard-layout">
    <section class="panel">
        <p class="eyebrow">Import</p>
        <h2>Preview a contact file</h2>
        <p>The Person preset must be installed. Files are read in memory, limited to 5 MiB and 1,000 contacts, and are not applied until you confirm every row. Possible duplicates are checked against saved people and earlier contacts in the file.</p>
        <label>
            vCard file
            <InputFile @key="_fileInputVersion" OnChange="PreviewAsync" accept=".vcf,text/vcard,text/x-vcard" />
        </label>
    </section>

    <section class="panel">
        <p class="eyebrow">Export</p>
        <h2>Select people to disclose</h2>
        <p>Exports include the selected records' mapped contact fields and semantically preserved source properties. Review the selection before downloading.</p>
        @if (!_hasPersonType)
        {
            <p class="empty-state">Install the Person preset to export contacts.</p>
        }
        else
        {
            <div class="action-row">
                <label class="grow-label">
                    Find people
                    <input @bind="_exportQuery" maxlength="300" placeholder="Name, alias, or searchable value" />
                </label>
                <button class="button" type="button" @onclick="ReloadPeopleAsync">Search</button>
            </div>
            @if (_people.Count == 0)
            {
                <p class="empty-state">No Person records match this search.</p>
            }
            else
            {
                <div class="export-picker">
                    @foreach (RecordSummary person in _people)
                    {
                        <label class="checkbox-label">
                            <input type="checkbox"
                                   checked="@_selectedExports.Contains(person.Id)"
                                   @onchange="args => ToggleExport(person.Id, args)" />
                            @person.DisplayName
                        </label>
                    }
                </div>
                @if (_peopleTotal > _people.Count)
                {
                    <p class="empty-state">Showing the first 100 of @_peopleTotal matches. Use the search above to narrow the export selection.</p>
                }
                @if (_selectedExports.Count > 0)
                {
                    <a class="button primary" href="@ExportHref()">Download @_selectedExports.Count selected (.vcf)</a>
                }
                else
                {
                    <button class="button primary" type="button" disabled>Select contacts to export</button>
                }
            }
        }
    </section>
</div>

<section class="panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Already imported</p>
            <h2>Fill fields from retained source data</h2>
            <p class="muted">
                Every contact import keeps the card it came from, exactly as it arrived. If a field did not exist at
                the time, its value is still there and can be recovered now without the original file. Values already
                present are never overwritten.
            </p>
        </div>
        <button class="button" type="button" disabled="@_backfillBusy" @onclick="LoadBackfillAsync">
            @(_backfillBusy ? "Checking…" : "Check what can be filled")
        </button>
    </div>

    @if (_backfill is not null)
    {
        @if (_backfill.Offers.Count == 0)
        {
            <p>Nothing further can be filled from the @_backfill.RecordsWithSource contact(s) holding source data.</p>
        }
        else
        {
            <p class="muted">@_backfill.RecordsWithSource contact(s) hold retained source data.</p>
            <ul class="item-list">
                @foreach (ContactBackfillOffer offer in _backfill.Offers)
                {
                    <li>
                        <label class="checkbox-label">
                            <input type="checkbox" checked="@_selectedBackfill.Contains(offer.Key)"
                                   @onchange="args => ToggleBackfill(offer.Key, args)" />
                            <strong>@offer.Label</strong>
                        </label>
                        <span class="muted">@(offer.RecordCount - offer.AlreadyFilledCount) of @offer.RecordCount contact(s) would be filled</span>
                        @if (!offer.FieldExists)
                        {
                            <span class="pill">creates a &ldquo;@offer.FieldName&rdquo; field</span>
                        }
                        <div class="muted">@offer.Description</div>
                    </li>
                }
            </ul>
            <div class="action-row">
                <button class="button primary" type="button" disabled="@(_backfillBusy || _selectedBackfill.Count == 0)"
                        @onclick="ApplyBackfillAsync">
                    @(_backfillBusy ? "Filling…" : "Fill selected fields")
                </button>
            </div>
        }
    }
</section>

@if (_preview is not null)
{
    <section class="panel vcard-review">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Import review</p>
                <h2>Review @_preview.Contacts.Count contact(s)</h2>
                <p class="muted">Confirm an action for every contact before applying the whole import in one transaction.</p>
            </div>
            <span class="pill">Target: @_preview.RecordTypeName</span>
        </div>
        @if (_preview.EnrichmentOffers.Count > 0)
        {
            <div class="panel enrichment-offers">
                <h3>This file carries more than the fields you have</h3>
                <p class="muted">
                    Tick anything you want kept. Creating a field adds it to the Person record type for good, so it
                    is filled by this import and by every later one. Everything here is retained as source data
                    whether or not you tick it.
                </p>
                <ul class="item-list">
                    @foreach (VCardEnrichmentOffer offer in _preview.EnrichmentOffers)
                    {
                        <li>
                            <label class="checkbox-label">
                                <input type="checkbox" disabled="@(offer.FieldExists && !offer.CreatesRecordImage)"
                                       checked="@_selectedEnrichments.Contains(offer.Key)"
                                       @onchange="args => ToggleEnrichment(offer.Key, args)" />
                                <strong>@offer.Label</strong>
                            </label>
                            <span class="muted">@offer.ContactCount contact(s)</span>
                            @if (offer.CreatesRecordImage)
                            {
                                <span class="pill">record image</span>
                            }
                            else if (offer.FieldExists)
                            {
                                <span class="pill">field exists</span>
                            }
                            else
                            {
                                <span class="pill">creates a &ldquo;@offer.FieldName&rdquo; field</span>
                            }
                            <div class="muted">@offer.Description</div>
                        </li>
                    }
                </ul>

                @if (RemotePhotoCount > 0)
                {
                    <div class="notice warning" role="note">
                        <p>
                            <strong>@RemotePhotoCount photo(s) in this file are not in the file itself</strong> &mdash; the cards
                            only say where to find them. Monkeysphere makes no outbound request of any kind unless you ask it to
                            here. Fetching them contacts those servers directly, which tells them this deployment's IP address,
                            when you imported, and that you hold these contacts.
                        </p>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_fetchRemotePhotos" />
                            Fetch photos held elsewhere and store them locally.
                        </label>
                    </div>
                }

                @if (PendingFieldEnrichments.Count > 0)
                {
                    <div class="action-row">
                        <button class="button" type="button" disabled="@_busy" @onclick="CreateFieldsAsync">
                            @(_busy ? "Creating…" : $"Create {PendingFieldEnrichments.Count} field(s) and preview again")
                        </button>
                    </div>
                }
            </div>
        }

        @if (_preview.Rejected.Count > 0)
        {
            <div class="notice warning" role="status">
                <p>
                    <strong>@_preview.Rejected.Count of @(_preview.Rejected.Count + _preview.Contacts.Count) card(s) in this file could not be read</strong>
                    and are listed below. They are not imported and nothing else about them is retained. The
                    remaining @_preview.Contacts.Count contact(s) import normally.
                </p>
                <ul>
                    @foreach (VCardRejectedCard rejected in _preview.Rejected)
                    {
                        <li>
                            <strong>Card @rejected.Position</strong>
                            @if (rejected.Label is string label)
                            {
                                <text>&nbsp;&mdash;&nbsp;@label</text>
                            }
                            <div class="muted">@rejected.Reason</div>
                        </li>
                    }
                </ul>
                <p class="muted">Fix these entries in the source file and import it again to add them.</p>
            </div>
        }

        @if (_preview.Contacts.Count == 0)
        {
            <p>No contact in this file could be read, so there is nothing to import.</p>
        }

        <div class="vcard-preview-list">
            @foreach (ImportEditor editor in _importEditors)
            {
                VCardContactPreview contact = editor.Contact;
                <article class="vcard-preview">
                    <div class="section-heading compact-heading">
                        <div>
                            <h3>@contact.DisplayName</h3>
                            <small>@contact.FieldMappings.Count mapped field(s) · @contact.OpaquePropertyIndexes.Count preserved property/properties</small>
                        </div>
                        @if (DuplicateCount(contact) > 0)
                        {
                            <span class="pill">@DuplicateCount(contact) possible duplicate(s)</span>
                        }
                    </div>
                    @if (contact.ImportDuplicateCandidates.Count > 0)
                    {
                        <div class="notice">
                            <strong>May duplicate an earlier contact in this file</strong>
                            <ul class="compact-list">
                                @foreach (VCardImportDuplicateCandidate candidate in contact.ImportDuplicateCandidates)
                                {
                                    <li>Contact @(candidate.ContactIndex + 1), @candidate.DisplayName: @string.Join(", ", candidate.Reasons)</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (contact.FieldMappings.Count > 0)
                    {
                        <ul class="compact-list">
                            @foreach (VCardFieldMapping mapping in contact.FieldMappings)
                            {
                                <li>@mapping.FieldName: @MappingDisplay(mapping)</li>
                            }
                        </ul>
                    }
                    <div class="form-grid">
                        <label>
                            Action
                            <SearchableSelect TValue="VCardImportAction" @bind-Value="editor.Action" Options="ImportActionOptions(contact)" AriaLabel="Import action" />
                            <small>@ActionExplanation(editor.Action)</small>
                        </label>
                        @if (editor.Action is VCardImportAction.MergeNonConflicting or VCardImportAction.ReplaceMappedValues)
                        {
                            <label>
                                Existing contact
                                <SearchableSelect TValue="string" @bind-Value="editor.ExistingRecordValue" Options="DuplicateOptions(contact)" AriaLabel="Existing contact" />
                            </label>
                        }
                    </div>
                </article>
            }
        </div>
        @if (_preview.Contacts.Count > 0)
        {
            <div class="vcard-review-actions">
                <button class="button primary" type="button" @onclick="ApplyAsync">Apply all choices transactionally</button>
            </div>
        }
    </section>
}

@code {
    private VCardImportPreview? _preview;
    private readonly HashSet<string> _selectedEnrichments = new(StringComparer.Ordinal);
    private bool _fetchRemotePhotos;
    private bool _busy;
    private byte[]? _lastFile;
    private int _fileInputVersion;

    private ContactBackfillPreview? _backfill;
    private readonly HashSet<string> _selectedBackfill = new(StringComparer.Ordinal);
    private bool _backfillBusy;

    private void ToggleBackfill(string key, ChangeEventArgs args)
    {
        if (args.Value is true) _selectedBackfill.Add(key);
        else _selectedBackfill.Remove(key);
    }

    private async Task LoadBackfillAsync()
    {
        _backfillBusy = true;
        try
        {
            _backfill = await Backfill.PreviewAsync();
            _selectedBackfill.Clear();
            _message = _backfill.Offers.Count == 0
                ? "Nothing further can be filled from retained source data."
                : $"{_backfill.Offers.Count} field(s) can be filled from retained source data.";
            _isError = false;
        }
        catch (DomainValidationException exception)
        {
            _backfill = null;
            _message = exception.Message;
            _isError = true;
        }
        finally
        {
            _backfillBusy = false;
        }
    }

    private async Task ApplyBackfillAsync()
    {
        _backfillBusy = true;
        try
        {
            ContactBackfillResult result = await Backfill.ApplyAsync([.. _selectedBackfill]);
            _message = $"Filled {result.ValuesWritten} value(s) across {result.RecordsUpdated} contact(s), creating {result.FieldsCreated} field(s).";
            _isError = false;
            _backfill = await Backfill.PreviewAsync();
            _selectedBackfill.Clear();
            await ReloadPeopleAsync();
        }
        catch (Exception exception) when (exception is DomainValidationException or ConcurrencyConflictException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally
        {
            _backfillBusy = false;
        }
    }

    private int RemotePhotoCount => _preview?.EnrichmentOffers
        .Where(offer => offer.CreatesRecordImage)
        .Sum(offer => offer.RemotePhotoCount) ?? 0;

    /// <summary>Selected enrichments that still need their field created before they can apply.</summary>
    private IReadOnlyList<string> PendingFieldEnrichments => _preview is null
        ? []
        : [.. _preview.EnrichmentOffers
            .Where(offer => !offer.CreatesRecordImage && !offer.FieldExists && _selectedEnrichments.Contains(offer.Key))
            .Select(offer => offer.Key)];

    private void ToggleEnrichment(string key, ChangeEventArgs args)
    {
        if (args.Value is true) _selectedEnrichments.Add(key);
        else _selectedEnrichments.Remove(key);
    }

    private async Task CreateFieldsAsync()
    {
        if (_preview is null || _lastFile is null) return;
        _busy = true;
        try
        {
            IReadOnlyList<FieldDefinition> created = await VCards.EnableEnrichmentsAsync(PendingFieldEnrichments);
            // Creating a field changes the structure revision, so the preview in hand is stale.
            // Reading the file again is the only honest way to show what will now be imported.
            await PreviewBytesAsync(_lastFile);
            _message = $"Created {created.Count} field(s). The preview below now includes their values.";
            _isError = false;
        }
        catch (Exception exception) when (exception is DomainValidationException or ConcurrencyConflictException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally
        {
            _busy = false;
        }
    }
    private readonly List<ImportEditor> _importEditors = [];
    private IReadOnlyList<RecordSummary> _people = [];
    private int _peopleTotal;
    private bool _hasPersonType;
    private string _exportQuery = string.Empty;
    private readonly HashSet<Guid> _selectedExports = [];
    private string? _message;
    private bool _isError;

    private static IReadOnlyList<ComboboxOption<VCardImportAction>> ImportActionOptions(VCardContactPreview contact)
    {
        List<ComboboxOption<VCardImportAction>> options =
        [
            new(VCardImportAction.CreateSeparately, "Create separately"),
            new(VCardImportAction.Skip, "Skip"),
        ];
        if (contact.DuplicateCandidates.Count > 0)
        {
            options.Add(new(VCardImportAction.MergeNonConflicting, "Merge non-conflicting values"));
            options.Add(new(VCardImportAction.ReplaceMappedValues, "Replace mapped values"));
        }

        return options;
    }

    private static int DuplicateCount(VCardContactPreview contact) =>
        contact.DuplicateCandidates.Count + contact.ImportDuplicateCandidates.Count;

    private static IReadOnlyList<ComboboxOption<string>> DuplicateOptions(VCardContactPreview contact) =>
        [.. contact.DuplicateCandidates.Select(candidate => new ComboboxOption<string>(candidate.RecordId.ToString(), $"{candidate.DisplayName} — {string.Join(", ", candidate.Reasons)}"))];

    protected override Task OnInitializedAsync() => ReloadPeopleAsync();

    private async Task PreviewAsync(InputFileChangeEventArgs args)
    {
        try
        {
            // Held so that creating fields can preview the same file again without asking for it
            // twice. Bounded by the parser's own file ceiling, and dropped once the import applies.
            await using Stream stream = args.File.OpenReadStream(VCardParser.MaximumBytes);
            using MemoryStream buffer = new();
            await stream.CopyToAsync(buffer);
            _selectedEnrichments.Clear();
            _fetchRemotePhotos = false;
            await PreviewBytesAsync(buffer.ToArray());
        }
        catch (Exception exception) when (exception is DomainValidationException or ConcurrencyConflictException or IOException)
        {
            _preview = null;
            _lastFile = null;
            _importEditors.Clear();
            _message = exception.Message;
            _isError = true;
        }
    }

    private async Task PreviewBytesAsync(byte[] content)
    {
        _lastFile = content;
        _preview = await VCards.PreviewAsync(content);
        _importEditors.Clear();
        _importEditors.AddRange(_preview.Contacts.Select(contact => new ImportEditor(contact)));
        _message = _preview.Rejected.Count == 0
            ? $"Previewed {_preview.Contacts.Count} contact(s). Review every action before applying."
            : $"Previewed {_preview.Contacts.Count} contact(s); {_preview.Rejected.Count} could not be read and are listed below.";
        _isError = false;
    }

    private async Task ApplyAsync()
    {
        if (_preview is null)
        {
            return;
        }

        try
        {
            VCardImportSelection[] selections = _importEditors.Select(editor => new VCardImportSelection(
                editor.Contact.Index,
                editor.Action,
                Guid.TryParse(editor.ExistingRecordValue, out Guid existingId) ? existingId : null)).ToArray();
            VCardImportResult result = await VCards.ApplyAsync(_preview, selections);
            string summary = $"Import complete: {result.Created} created, {result.Merged} merged, {result.Replaced} replaced, {result.Skipped} skipped.";
            if (_selectedEnrichments.Contains(ContactEnrichments.Photo))
            {
                // Photos are attached after the records exist. A photo that cannot be had is
                // reported here rather than undoing an import that otherwise succeeded.
                ContactPhotoImportResult photos = await ContactPhotos.AttachAsync(
                    _preview, _fetchRemotePhotos ? PhotoFetcher : null);
                summary += $" Photos: {photos.Attached} attached";
                if (photos.Skipped > 0) summary += $", {photos.Skipped} skipped";
                if (photos.Failed > 0) summary += $", {photos.Failed} could not be read";
                summary += ".";
            }

            _message = summary;
            _isError = false;
            _preview = null;
            _lastFile = null;
            _selectedEnrichments.Clear();
            _fetchRemotePhotos = false;
            _importEditors.Clear();
            await ReloadPeopleAsync();
        }
        catch (Exception exception) when (exception is DomainValidationException or ConcurrencyConflictException)
        {
            if (exception is ConcurrencyConflictException)
            {
                _preview = null;
                _importEditors.Clear();
                _fileInputVersion++;
            }
            _message = exception.Message;
            _isError = true;
        }
    }

    private async Task ReloadPeopleAsync()
    {
        RecordType? person = (await Records.ListRecordTypesAsync()).FirstOrDefault(type =>
            type.Lifecycle == RecordTypeLifecycle.Active && type.PresetKey == "monkeysphere.person");
        _hasPersonType = person is not null;
        PagedResult<RecordSummary>? people = person is null
            ? null
            : await Records.SearchRecordsAsync(new(
                Query: string.IsNullOrWhiteSpace(_exportQuery) ? null : _exportQuery,
                RecordTypeId: person.Id,
                PageSize: 100));
        _people = people?.Items ?? [];
        _peopleTotal = people?.TotalCount ?? 0;
        _selectedExports.RemoveWhere(id => !_people.Any(person => person.Id == id));
    }

    private void ToggleExport(Guid id, ChangeEventArgs args)
    {
        if (args.Value is true)
        {
            _selectedExports.Add(id);
        }
        else
        {
            _selectedExports.Remove(id);
        }
    }

    private string ExportHref() => "/vcard/export.vcf?ids=" + string.Join(',', _selectedExports.Order());

    private static string MappingDisplay(VCardFieldMapping mapping) =>
        mapping.Input.ScalarValue ?? mapping.Input.Temporal?.Value ?? "mapped value";

    private static string ActionExplanation(VCardImportAction action) => action switch
    {
        VCardImportAction.CreateSeparately => "Creates a new record even when a possible duplicate exists.",
        VCardImportAction.Skip => "Makes no database changes for this contact.",
        VCardImportAction.MergeNonConflicting => "Keeps the existing name and values, fills empty mapped fields, adds aliases, and preserves conflicts for export.",
        VCardImportAction.ReplaceMappedValues => "Replaces the primary name, aliases, and fields present in this vCard; unrelated local fields remain.",
        _ => string.Empty,
    };

    private sealed class ImportEditor
    {
        public ImportEditor(VCardContactPreview contact)
        {
            Contact = contact;
            Action = contact.RecommendedAction;
            ExistingRecordValue = contact.DuplicateCandidates.FirstOrDefault()?.RecordId.ToString() ?? string.Empty;
        }

        public VCardContactPreview Contact { get; }
        public VCardImportAction Action { get; set; }
        public string ExistingRecordValue { get; set; }
    }
}
