@page "/"
@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDashboardService Dashboard
@inject IMonkeysphereService Records
@inject TimeProvider TimeProvider

<PageTitle>Dashboard · Monkeysphere</PageTitle>

<div class="page-heading dashboard-heading">
    <div><p class="eyebrow">At a glance</p><h1>Dashboard</h1><p>Upcoming moments and the records you want close at hand.</p></div>
    <a class="button" href="/settings/dashboard">Configure dashboard</a>
</div>

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <section class="panel dashboard-upcoming" aria-labelledby="upcoming-heading">
        <div class="section-heading">
            <div><p class="eyebrow">Next @_configuration.UpcomingDays days</p><h2 id="upcoming-heading">Upcoming dates</h2></div>
            <a class="button subtle" href="/calendar">Open calendar</a>
        </div>
        @if (_upcoming.Count == 0)
        {
            <p class="empty-state">No recurring dates are coming up.</p>
        }
        else
        {
            <div class="dashboard-date-list">
                @foreach (DashboardUpcomingDate item in _upcoming)
                {
                    <article class="dashboard-date-item">
                        <div class="dashboard-date-marker" aria-hidden="true"><strong>@item.OccursAt.Day</strong><span>@item.OccursAt.ToString("MMM", CultureInfo.CurrentCulture)</span></div>
                        <div class="dashboard-date-details"><RecordIdentity RecordId="item.Source.RecordId" DisplayName="@item.Source.RecordDisplayName" ImageId="item.Source.ImageId" Symbol="@item.Source.RecordTypeSymbol" Compact="true" /><span>@item.Source.FieldName · @OccurrenceLabel(item)</span></div>
                        <strong class="dashboard-distance">@DistanceLabel(item)</strong>
                    </article>
                }
            </div>
        }
    </section>

    @if (_categories.Count == 0)
    {
        <section class="panel dashboard-records"><p class="empty-state">Choose one or more record categories in Dashboard settings.</p></section>
    }
    @foreach (DashboardCategory category in _categories.Where(item => item.Records.TotalCount > 0))
    {
        <section class="panel dashboard-records" aria-labelledby="dashboard-records-@category.Type.Id">
            <div class="section-heading">
                <div><p class="eyebrow">Front-page records</p><h2 id="dashboard-records-@category.Type.Id">@category.DisplayName</h2></div>
                <div class="action-row wrap">
                    <a class="button" href="/records/new?typeId=@category.Type.Id">Add @category.Type.Name</a>
                    <a class="button subtle" href="/records?typeId=@category.Type.Id">View all</a>
                </div>
            </div>
            <ul class="item-list dashboard-record-list">
                @foreach (DashboardRecordRow row in category.Rows)
                {
                    <li>
                        <RecordIdentity RecordId="row.Record.Id" DisplayName="@row.Record.DisplayName"
                                        ImageId="row.ImageId" Symbol="@category.Symbol" />
                        <span class="muted">Updated @row.Record.UpdatedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</span>
                    </li>
                }
            </ul>
            @if (category.Records.TotalCount > category.Records.Items.Count)
            {
                <p class="dashboard-more"><a href="/records?typeId=@category.Type.Id">View all @category.Records.TotalCount @category.DisplayName.ToLower(CultureInfo.CurrentCulture)</a></p>
            }
        </section>
    }

    @* A category with nothing in it used to get a panel of its own saying so. Once a record type
       began reaching the dashboard without being asked for, a fresh deployment was mostly panels
       reading "No workplace yet" -- the useful content pushed below three of them. They are worth
       keeping, because the link is where somebody starts the first one, but not worth a panel each. *@
    @if (_emptyCategories.Count > 0)
    {
        <section class="panel dashboard-empty" aria-labelledby="dashboard-nothing-yet">
            <p class="eyebrow">Nothing yet</p>
            <h2 id="dashboard-nothing-yet" class="visually-hidden">Categories with no records</h2>
            <div class="action-row wrap">
                @foreach (DashboardCategory category in _emptyCategories)
                {
                    <a class="button subtle" href="/records/new?typeId=@category.Type.Id">Add @category.Type.Name</a>
                }
            </div>
        </section>
    }
}

@code {
    private DashboardConfiguration _configuration = new([], []);
    private IReadOnlyList<DashboardUpcomingDate> _upcoming = [];
    private readonly List<DashboardCategory> _categories = [];
    private bool _loading = true;

    /// <summary>
    /// The categories holding nothing. Gathered rather than filtered inline so the markup reads as the
    /// two things the page shows: what is there, and where to start what is not.
    /// </summary>
    private List<DashboardCategory> _emptyCategories =>
        [.. _categories.Where(category => category.Records.TotalCount == 0)];

    protected override async Task OnInitializedAsync()
    {
        _configuration = await Dashboard.GetConfigurationAsync();
        _upcoming = await Dashboard.ListUpcomingAsync(_configuration);
        Dictionary<Guid, RecordType> types = (await Records.ListRecordTypesAsync()).ToDictionary(type => type.Id);
        foreach (Guid recordTypeId in _configuration.RecordTypeIds)
        {
            if (!types.TryGetValue(recordTypeId, out RecordType? type)) continue;
            PagedResult<RecordSummary> results = await Records.SearchRecordsAsync(new RecordSearch(RecordTypeId: recordTypeId, PageSize: 12));
            List<DashboardRecordRow> rows = [];
            foreach (RecordSummary summary in results.Items)
            {
                RecordDetails? details = await Records.GetRecordAsync(summary.Id);
                RecordImage? image = details?.Images.FirstOrDefault(item => item.IsCover) ?? details?.Images.FirstOrDefault();
                rows.Add(new(summary, image?.Id));
            }
            string displayName = string.Equals(type.PresetKey, "monkeysphere.person", StringComparison.Ordinal) ? "People" : type.Name;
            _categories.Add(new(type, displayName, type.Symbol ?? type.Name[..1].ToUpper(CultureInfo.CurrentCulture), results, rows));
        }
        _loading = false;
    }

    private string DistanceLabel(DashboardUpcomingDate item)
    {
        DateTimeOffset now = TimeProvider.GetLocalNow();
        if (!item.HasTime)
        {
            int days = DateOnly.FromDateTime(item.OccursAt.DateTime).DayNumber - DateOnly.FromDateTime(now.DateTime).DayNumber;
            return days switch { 0 => "Today", 1 => "Tomorrow", _ => $"In {days} days" };
        }
        double hours = Math.Max(0, (item.OccursAt - now).TotalHours);
        if (hours < 48)
        {
            int roundedHours = Math.Max(1, (int)Math.Ceiling(hours));
            return $"In {roundedHours} hour{(roundedHours == 1 ? string.Empty : "s")}";
        }
        return $"In {(int)Math.Ceiling(hours / 24)} days";
    }

    private static string OccurrenceLabel(DashboardUpcomingDate item) => item.HasTime
        ? item.OccursAt.ToString("ddd d MMM, HH:mm", CultureInfo.CurrentCulture)
        : item.OccursAt.ToString("dddd d MMMM", CultureInfo.CurrentCulture);

    private sealed record DashboardRecordRow(RecordSummary Record, Guid? ImageId);
    private sealed record DashboardCategory(RecordType Type, string DisplayName, string Symbol, PagedResult<RecordSummary> Records, IReadOnlyList<DashboardRecordRow> Rows);
}
