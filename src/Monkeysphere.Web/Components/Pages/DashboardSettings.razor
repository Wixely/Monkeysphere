@page "/settings/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDashboardService Dashboard
@inject IMonkeysphereService Records

<PageTitle>Dashboard settings · Monkeysphere</PageTitle>

<SettingsTabs Active="dashboard" />

<div class="page-heading">
    <div>
        <p class="eyebrow">Front page</p>
        <h1>Dashboard</h1>
        <p>Choose and order the categories and annually recurring dates shown when you open Monkeysphere.</p>
    </div>
    <a class="button" href="/">Open dashboard</a>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "error" : "success")" role="status">@_message</div>
}

@if (_loading)
{
    <p>Loading…</p>
}
else
{
    <section class="panel dashboard-settings-panel">
        <label class="dashboard-period">
            Upcoming period
            <SearchableSelect TValue="int" @bind-Value="_upcomingDays" Options="UpcomingDayOptions" AriaLabel="Dashboard upcoming period" />
            <small>Recurring dates within this period appear above the category lists.</small>
        </label>

        <fieldset class="field-picker dashboard-date-fields">
            <legend>Dashboard categories</legend>
            @foreach (RecordType type in _types)
            {
                <label class="checkbox-label">
                    <input type="checkbox" checked="@_selectedTypes.Contains(type.Id)" @onchange="args => SetType(type.Id, args)" />
                    <span>@DisplayTypeName(type)</span>
                </label>
            }
        </fieldset>
        <OrderedSelection Title="Category order" EmptyText="Select at least one category above to display record lists."
                          Items="SelectedTypeItems" MoveUp="MoveTypeUp" MoveDown="MoveTypeDown" Remove="RemoveType" />

        <fieldset class="field-picker dashboard-date-fields">
            <legend>Annually recurring date fields</legend>
            @if (_dateFields.Count == 0)
            {
                <p class="empty-state">No active date fields are available.</p>
            }
            else
            {
                @foreach (FieldDefinition field in _dateFields)
                {
                    <label class="checkbox-label">
                        <input type="checkbox" checked="@_selectedDateFields.Contains(field.Id)" @onchange="args => SetDateField(field.Id, args)" />
                        <span>@DateFieldLabel(field)</span>
                    </label>
                }
            }
        </fieldset>
        <OrderedSelection Title="Upcoming-date order" EmptyText="No recurring dates are enabled."
                          Items="SelectedDateItems" MoveUp="MoveDateUp" MoveDown="MoveDateDown" Remove="RemoveDate" />

        <p class="muted">Birthdays from the People preset are selected automatically until you save your own choices.</p>
        <button class="button primary" type="button" @onclick="SaveAsync">Save dashboard</button>
    </section>
}

@code {
    private IReadOnlyList<RecordType> _types = [];
    private IReadOnlyList<FieldDefinition> _dateFields = [];
    private readonly List<Guid> _selectedTypes = [];
    private readonly List<Guid> _selectedDateFields = [];
    private readonly Dictionary<Guid, List<string>> _dateFieldTypeNames = [];
    private int _upcomingDays = DashboardService.DefaultUpcomingDays;
    private string? _message;
    private bool _isError;
    private bool _loading = true;

    private IReadOnlyList<OrderedSelectionItem> SelectedTypeItems => _selectedTypes
        .Select(id => new OrderedSelectionItem(id, DisplayTypeName(_types.Single(type => type.Id == id))))
        .ToArray();
    private IReadOnlyList<OrderedSelectionItem> SelectedDateItems => _selectedDateFields
        .Select(id => new OrderedSelectionItem(id, DateFieldLabel(_dateFields.Single(item => item.Id == id))))
        .ToArray();
    private static IReadOnlyList<ComboboxOption<int>> UpcomingDayOptions { get; } =
        [new(30, "Next 30 days"), new(60, "Next 60 days"), new(90, "Next 90 days"), new(180, "Next 6 months"), new(366, "Next year")];

    protected override async Task OnInitializedAsync()
    {
        _types = (await Records.ListRecordTypesAsync()).Where(type => type.Lifecycle == RecordTypeLifecycle.Active).ToArray();
        _dateFields = (await Records.ListFieldDefinitionsAsync())
            .Where(field => field.Lifecycle == FieldLifecycle.Active && field.TypeId is FieldTypes.ExactDate or FieldTypes.Temporal)
            .OrderBy(field => field.Name, StringComparer.CurrentCultureIgnoreCase).ToArray();
        HashSet<Guid> dateFieldIds = _dateFields.Select(field => field.Id).ToHashSet();
        foreach (RecordType type in _types)
        {
            RecordTypeDetails? details = await Records.GetRecordTypeAsync(type.Id);
            foreach (Guid fieldId in details?.Fields.Select(field => field.Definition.Id).Where(dateFieldIds.Contains) ?? [])
            {
                if (!_dateFieldTypeNames.TryGetValue(fieldId, out List<string>? names))
                {
                    names = [];
                    _dateFieldTypeNames.Add(fieldId, names);
                }
                names.Add(DisplayTypeName(type));
            }
        }

        DashboardConfiguration configuration = await Dashboard.GetConfigurationAsync();
        _selectedTypes.AddRange(configuration.RecordTypeIds.Where(id => _types.Any(type => type.Id == id)));
        _selectedDateFields.AddRange(configuration.RecurringFieldDefinitionIds.Where(id => _dateFields.Any(field => field.Id == id)));
        _upcomingDays = configuration.UpcomingDays;
        _loading = false;
    }

    private void SetType(Guid id, ChangeEventArgs args) => SetSelected(_selectedTypes, id, args);
    private void SetDateField(Guid id, ChangeEventArgs args) => SetSelected(_selectedDateFields, id, args);
    private static void SetSelected(List<Guid> selected, Guid id, ChangeEventArgs args)
    {
        if (args.Value is true && !selected.Contains(id)) selected.Add(id);
        else if (args.Value is not true) selected.Remove(id);
    }

    private void MoveTypeUp(Guid id) => Move(_selectedTypes, id, -1);
    private void MoveTypeDown(Guid id) => Move(_selectedTypes, id, 1);
    private void RemoveType(Guid id) => _selectedTypes.Remove(id);
    private void MoveDateUp(Guid id) => Move(_selectedDateFields, id, -1);
    private void MoveDateDown(Guid id) => Move(_selectedDateFields, id, 1);
    private void RemoveDate(Guid id) => _selectedDateFields.Remove(id);
    private static void Move(List<Guid> items, Guid id, int offset)
    {
        int from = items.IndexOf(id);
        int to = from + offset;
        if (from >= 0 && to >= 0 && to < items.Count) (items[from], items[to]) = (items[to], items[from]);
    }

    private async Task SaveAsync()
    {
        try
        {
            await Dashboard.SaveConfigurationAsync(new(_selectedTypes.ToArray(), _selectedDateFields.ToArray(), _upcomingDays));
            _message = "Dashboard settings saved.";
            _isError = false;
        }
        catch (DomainValidationException exception)
        {
            _message = exception.Message;
            _isError = true;
        }
    }

    private static string DisplayTypeName(RecordType type) =>
        string.Equals(type.PresetKey, "monkeysphere.person", StringComparison.Ordinal) ? "People" : type.Name;
    private string DateFieldLabel(FieldDefinition field) => _dateFieldTypeNames.TryGetValue(field.Id, out List<string>? names)
        ? $"{field.Name} · {string.Join(", ", names)}" : field.Name;
}
