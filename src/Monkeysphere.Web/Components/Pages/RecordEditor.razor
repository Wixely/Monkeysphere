@page "/records/new"
@page "/records/{RecordId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IMonkeysphereService Service
@inject IRecordImageService ImageService
@inject IRelationshipService RelationshipService
@inject NavigationManager Navigation

<PageTitle>@(RecordId.HasValue ? "Edit record" : "New record") · Monkeysphere</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else if (RecordId.HasValue && _record is null)
{
    <h1>Record not found</h1>
    <p><a href="/records">Return to records</a></p>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">@(RecordId.HasValue ? "Edit record" : "New record")</p>
            <h1>@(RecordId.HasValue ? _model.DisplayName : "Add to your sphere")</h1>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice error" role="alert">@_message</div>
    }

    @if (_types.Count == 0)
    {
        <section class="panel">
            <p>You need a record type before you can create a record.</p>
            <a class="button primary" href="/record-types">Create a record type</a>
        </section>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="panel record-form">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>
                    Record type
                    <select value="@_selectedTypeValue" @onchange="TypeChangedAsync" disabled="@RecordId.HasValue">
                        <option value="">Select a type</option>
                        @foreach (RecordType type in _types)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </label>
                <label>
                    Display name
                    <InputText @bind-Value="_model.DisplayName" />
                    <ValidationMessage For="() => _model.DisplayName" />
                </label>
                <label class="form-wide">
                    Aliases and nicknames
                    <textarea @bind="_model.Aliases" rows="3" placeholder="One alternate name per line"></textarea>
                    <span class="muted">Short names, nicknames, former names, local names, or anything else you may search for.</span>
                </label>
            </div>

            @if (_selectedType is not null)
            {
                <div class="field-stack">
                    @foreach (EditorField editor in _editors)
                    {
                        <div class="field-card">
                            <label>
                                @editor.Field.Definition.Name
                                @if (editor.Field.IsRequired)
                                {
                                    <span class="required">required</span>
                                }
                                @if (editor.Field.Definition.Lifecycle == FieldLifecycle.Retired)
                                {
                                    <span class="pill">retired</span>
                                }
                                @switch (editor.Field.Definition.TypeId)
                                {
                                    case FieldTypes.MultilineText:
                                        <textarea @bind="editor.Scalar" rows="5"></textarea>
                                        break;
                                    case FieldTypes.Number:
                                        <input @bind="editor.Scalar" inputmode="decimal" placeholder="Invariant number, for example 42.5" />
                                        break;
                                    case FieldTypes.ExactDate:
                                        <input type="date" value="@editor.Scalar" @onchange="args => SetScalar(editor, args)" />
                                        break;
                                    case FieldTypes.Choice:
                                        <select @bind="editor.Scalar">
                                            <option value="">Choose…</option>
                                            @foreach (string choice in FieldTypes.ChoiceOptions(editor.Field.Definition))
                                            {
                                                <option value="@choice">@choice</option>
                                            }
                                        </select>
                                        break;
                                    case FieldTypes.Tags:
                                        <input @bind="editor.Tags" placeholder="Comma-separated tags" />
                                        break;
                                    case FieldTypes.Temporal:
                                        <select @bind="editor.TemporalPrecision">
                                            @foreach (TemporalPrecision precision in Enum.GetValues<TemporalPrecision>())
                                            {
                                                <option value="@precision">@precision</option>
                                            }
                                        </select>
                                        <input @bind="editor.Scalar" placeholder="@TemporalValues.InputHint(editor.TemporalPrecision)" />
                                        <span class="checkbox-label">
                                            <input type="checkbox" @bind="editor.IsApproximate" />
                                            Approximate
                                        </span>
                                        <input @bind="editor.ApproximationNote" placeholder="Optional explanation of the uncertainty" />
                                        break;
                                    case FieldTypes.PhoneNumber:
                                        <input @bind="editor.Scalar" type="tel" autocomplete="tel" />
                                        break;
                                    case FieldTypes.WebLink:
                                        <input @bind="editor.Scalar" type="url" inputmode="url" placeholder="https://example.test/" />
                                        break;
                                    case FieldTypes.Location:
                                        <div class="location-editor">
                                            <textarea @bind="editor.LocationContext" rows="3" placeholder="Place name, address, area, or other useful context"></textarea>
                                            <div class="location-coordinate-grid">
                                                <div>
                                                    <span>Latitude</span>
                                                    <input @bind="editor.Latitude" aria-label="Latitude" inputmode="decimal" placeholder="51.5074" />
                                                </div>
                                                <div>
                                                    <span>Longitude</span>
                                                    <input @bind="editor.Longitude" aria-label="Longitude" inputmode="decimal" placeholder="-0.1278" />
                                                </div>
                                                <div>
                                                    <span>Coordinate accuracy (metres)</span>
                                                    <input @bind="editor.LocationAccuracyMetres" aria-label="Coordinate accuracy in metres" inputmode="decimal" placeholder="Optional" />
                                                </div>
                                                <div>
                                                    <span>Approximation radius (km)</span>
                                                    <input @bind="editor.LocationRadiusKilometres" aria-label="Approximation radius in kilometres" inputmode="decimal" placeholder="Optional" />
                                                </div>
                                            </div>
                                            <span class="muted">Coordinates use WGS84 decimal degrees. Accuracy describes the coordinate source; radius describes the area you mean.</span>
                                        </div>
                                        break;
                                    default:
                                        <input @bind="editor.Scalar" />
                                        break;
                                }
                            </label>
                            @if (!FieldTypes.Recognized.Contains(editor.Field.Definition.TypeId, StringComparer.Ordinal))
                            {
                                <span class="muted">Unknown type <code>@editor.Field.Definition.TypeId</code> uses lossless text editing.</span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="action-row">
                <button class="button primary" type="submit">@(RecordId.HasValue ? "Save changes" : "Create record")</button>
                <a class="button" href="/records">Cancel</a>
            </div>
        </EditForm>

        @if (RecordId.HasValue)
        {
            <section class="panel">
                <div class="section-heading">
                    <div>
                        <h2>Images</h2>
                        <span class="muted">@_images.Count of @IRecordImageService.MaximumImagesPerRecord</span>
                    </div>
                    <InputFile OnChange="UploadImagesAsync"
                               multiple
                               accept="image/jpeg,image/png,image/webp"
                               disabled="@(_uploading || _images.Count >= IRecordImageService.MaximumImagesPerRecord)" />
                </div>
                <p class="muted">JPEG, PNG, or WebP; up to 10 MB and 24 megapixels each. Source files stay private and display copies have embedded metadata removed.</p>
                @if (_images.Count == 0)
                {
                    <p class="empty-state">No images attached.</p>
                }
                else
                {
                    <div class="image-grid">
                        @foreach (RecordImage image in _images)
                        {
                            <figure class="record-image">
                                <a href="/records/@image.RecordId/images/@image.Id/preview" target="_blank" rel="noopener">
                                    <img src="/records/@image.RecordId/images/@image.Id/thumbnail"
                                         alt="@image.OriginalFileName"
                                         loading="lazy" />
                                </a>
                                <figcaption>
                                    <span title="@image.OriginalFileName">@image.OriginalFileName</span>
                                    <small>@image.Width Ã— @image.Height</small>
                                    <button class="button danger" type="button" @onclick="() => DeleteImageAsync(image.Id)">Remove</button>
                                </figcaption>
                            </figure>
                        }
                    </div>
                }
            </section>

            <section class="panel">
                <div class="section-heading">
                    <h2>Relationships</h2>
                    <span class="muted">@_relationships.Count connected</span>
                </div>
                @if (_relationships.Count == 0)
                {
                    <p class="empty-state">No relationships recorded.</p>
                }
                else
                {
                    <ul class="item-list">
                        @foreach (RelationshipView relationship in _relationships)
                        {
                            <li>
                                <div>
                                    <span>@relationship.Label</span>
                                    <a href="/records/@relationship.RelatedRecordId">@relationship.RelatedDisplayName</a>
                                    @if (!string.IsNullOrWhiteSpace(relationship.Note))
                                    {
                                        <span class="muted">@relationship.Note</span>
                                    }
                                </div>
                                <button class="button danger" type="button" @onclick="() => RemoveRelationshipAsync(relationship.Id)">Remove</button>
                            </li>
                        }
                    </ul>
                }

                @if (_activeRelationshipTypes.Count == 0)
                {
                    <p><a href="/relationship-types">Define a relationship type</a> to connect this record.</p>
                }
                else
                {
                    <div class="form-grid">
                        <label>
                            Relationship
                            <select @bind="_relationshipTypeValue">
                                <option value="">Choose…</option>
                                @foreach (RelationshipType type in _activeRelationshipTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            Find a record
                            <input @bind="_relatedQuery" placeholder="Name" />
                        </label>
                        <label>
                            Related record
                            <select @bind="_relatedRecordValue">
                                <option value="">Choose…</option>
                                @foreach (RecordSummary candidate in _relatedCandidates)
                                {
                                    <option value="@candidate.Id">@candidate.DisplayName (@candidate.RecordTypeName)</option>
                                }
                            </select>
                        </label>
                        <label>
                            Note
                            <input @bind="_relationshipNote" />
                        </label>
                    </div>
                    <div class="action-row">
                        <button class="button" type="button" @onclick="SearchRelatedAsync">Search records</button>
                        <button class="button primary" type="button" @onclick="AddRelationshipAsync">Add relationship</button>
                    </div>
                }
            </section>

            <section class="panel danger-zone">
                <h2>Delete record</h2>
                <p>This removes the record, its field values, relationships, aliases, and attached images. Backups may still retain older copies.</p>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="_confirmDelete" />
                    I understand this record will be deleted.
                </label>
                <button class="button danger" type="button" disabled="@(!_confirmDelete)" @onclick="DeleteAsync">Delete record</button>
            </section>
        }
    }
}

@code {
    [Parameter]
    public Guid? RecordId { get; set; }

    [SupplyParameterFromQuery(Name = "typeId")]
    public Guid? InitialTypeId { get; set; }

    private readonly RecordModel _model = new();
    private IReadOnlyList<RecordType> _types = [];
    private RecordTypeDetails? _selectedType;
    private RecordDetails? _record;
    private List<EditorField> _editors = [];
    private string _selectedTypeValue = string.Empty;
    private string? _message;
    private bool _loading = true;
    private bool _confirmDelete;
    private IReadOnlyList<RelationshipView> _relationships = [];
    private IReadOnlyList<RelationshipType> _activeRelationshipTypes = [];
    private IReadOnlyList<RecordSummary> _relatedCandidates = [];
    private string _relationshipTypeValue = string.Empty;
    private string _relatedRecordValue = string.Empty;
    private string _relatedQuery = string.Empty;
    private string _relationshipNote = string.Empty;
    private IReadOnlyList<RecordImage> _images = [];
    private bool _uploading;

    protected override async Task OnParametersSetAsync()
    {
        _types = await Service.ListRecordTypesAsync();
        if (RecordId is Guid id)
        {
            _record = await Service.GetRecordAsync(id);
            if (_record is not null)
            {
                _model.DisplayName = _record.Record.DisplayName;
                _model.Aliases = string.Join(Environment.NewLine, _record.Aliases);
                _images = _record.Images;
                _selectedTypeValue = _record.Record.RecordTypeId.ToString();
                _selectedType = await Service.GetRecordTypeAsync(_record.Record.RecordTypeId);
                BuildEditors(_record);
                await LoadRelationshipsAsync(id);
            }
        }
        else if (InitialTypeId is Guid typeId)
        {
            _selectedTypeValue = typeId.ToString();
            _selectedType = await Service.GetRecordTypeAsync(typeId);
            BuildEditors(null);
        }

        _loading = false;
    }

    private async Task TypeChangedAsync(ChangeEventArgs args)
    {
        _selectedTypeValue = args.Value?.ToString() ?? string.Empty;
        _selectedType = Guid.TryParse(_selectedTypeValue, out Guid typeId)
            ? await Service.GetRecordTypeAsync(typeId)
            : null;
        BuildEditors(null);
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_selectedType is null)
            {
                throw new DomainValidationException("Select a record type.");
            }

            FieldValueInput[] values = _editors.Select(editor =>
                string.Equals(editor.Field.Definition.TypeId, FieldTypes.Tags, StringComparison.Ordinal)
                    ? new FieldValueInput(
                        editor.Field.Definition.Id,
                        Tags: string.IsNullOrWhiteSpace(editor.Tags)
                            ? []
                            : editor.Tags.Split(',', StringSplitOptions.TrimEntries))
                    : string.Equals(editor.Field.Definition.TypeId, FieldTypes.Temporal, StringComparison.Ordinal)
                        ? new FieldValueInput(
                            editor.Field.Definition.Id,
                            Temporal: new TemporalValueInput(
                                editor.Scalar,
                                editor.TemporalPrecision,
                                editor.IsApproximate,
                                editor.ApproximationNote))
                        : string.Equals(editor.Field.Definition.TypeId, FieldTypes.Location, StringComparison.Ordinal)
                            ? new FieldValueInput(
                                editor.Field.Definition.Id,
                                Location: new LocationValueInput(
                                    editor.LocationContext,
                                    editor.Latitude,
                                    editor.Longitude,
                                    editor.LocationAccuracyMetres,
                                    editor.LocationRadiusKilometres))
                        : new FieldValueInput(editor.Field.Definition.Id, editor.Scalar)).ToArray();

            RecordDetails saved = RecordId is Guid id
                ? await Service.UpdateRecordAsync(id, _model.DisplayName, values, ParseAliases())
                : await Service.CreateRecordAsync(_selectedType.RecordType.Id, _model.DisplayName, values, ParseAliases());
            Navigation.NavigateTo($"/records/{saved.Record.Id}");
        }
        catch (Exception exception) when (exception is DomainValidationException or InvalidOperationException)
        {
            _message = exception.Message;
        }
    }

    private async Task DeleteAsync()
    {
        if (!_confirmDelete || RecordId is not Guid id)
        {
            return;
        }

        await Service.DeleteRecordAsync(id);
        Navigation.NavigateTo("/records");
    }

    private async Task UploadImagesAsync(InputFileChangeEventArgs args)
    {
        if (RecordId is not Guid recordId)
        {
            return;
        }

        try
        {
            _uploading = true;
            int remaining = IRecordImageService.MaximumImagesPerRecord - _images.Count;
            foreach (IBrowserFile file in args.GetMultipleFiles(Math.Max(remaining, 1)))
            {
                await using Stream content = file.OpenReadStream(IRecordImageService.MaximumUploadBytes);
                await ImageService.AddAsync(recordId, content, file.Name);
            }

            _record = await Service.GetRecordAsync(recordId);
            _images = _record?.Images ?? [];
            _message = null;
        }
        catch (Exception exception) when (exception is DomainValidationException or InvalidOperationException or IOException)
        {
            _message = exception.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DeleteImageAsync(Guid imageId)
    {
        if (RecordId is not Guid recordId)
        {
            return;
        }

        await ImageService.DeleteAsync(recordId, imageId);
        _record = await Service.GetRecordAsync(recordId);
        _images = _record?.Images ?? [];
    }

    private async Task LoadRelationshipsAsync(Guid recordId)
    {
        _relationships = await RelationshipService.ListForRecordAsync(recordId);
        _activeRelationshipTypes = (await RelationshipService.ListTypesAsync())
            .Where(type => type.Lifecycle == RelationshipLifecycle.Active)
            .ToArray();
        await SearchRelatedAsync();
    }

    private async Task SearchRelatedAsync()
    {
        PagedResult<RecordSummary> result = await Service.SearchRecordsAsync(new RecordSearch(
            Query: _relatedQuery,
            PageSize: 100));
        _relatedCandidates = result.Items.Where(item => item.Id != RecordId).ToArray();
        if (!_relatedCandidates.Any(item => item.Id.ToString() == _relatedRecordValue))
        {
            _relatedRecordValue = string.Empty;
        }
    }

    private async Task AddRelationshipAsync()
    {
        try
        {
            if (RecordId is not Guid sourceId ||
                !Guid.TryParse(_relationshipTypeValue, out Guid typeId) ||
                !Guid.TryParse(_relatedRecordValue, out Guid targetId))
            {
                throw new DomainValidationException("Choose a relationship type and related record.");
            }

            await RelationshipService.CreateAsync(typeId, sourceId, targetId, _relationshipNote);
            _relationshipNote = string.Empty;
            _relatedRecordValue = string.Empty;
            _message = null;
            await LoadRelationshipsAsync(sourceId);
        }
        catch (Exception exception) when (exception is DomainValidationException or InvalidOperationException)
        {
            _message = exception.Message;
        }
    }

    private async Task RemoveRelationshipAsync(Guid relationshipId)
    {
        await RelationshipService.DeleteAsync(relationshipId);
        if (RecordId is Guid recordId)
        {
            await LoadRelationshipsAsync(recordId);
        }
    }

    private void BuildEditors(RecordDetails? record)
    {
        if (_selectedType is null)
        {
            _editors = [];
            return;
        }

        Dictionary<Guid, RecordValue> values = (record?.Values ?? [])
            .ToDictionary(value => value.FieldDefinitionId);
        _editors = _selectedType.Fields
            .Where(field => field.Definition.Lifecycle == FieldLifecycle.Active || values.ContainsKey(field.Definition.Id))
            .Select(field =>
            {
                values.TryGetValue(field.Definition.Id, out RecordValue? value);
                return new EditorField
                {
                    Field = field,
                    Scalar = value?.TemporalValue ?? value?.TextValue ?? value?.NumberValue ?? value?.DateValue ?? string.Empty,
                    Tags = value is null ? string.Empty : string.Join(", ", value.Tags),
                    TemporalPrecision = value?.TemporalPrecision ?? TemporalPrecision.Day,
                    IsApproximate = value?.IsApproximate == true,
                    ApproximationNote = value?.ApproximationNote ?? string.Empty,
                    LocationContext = value?.Location?.DisplayContext ?? value?.TextValue ?? string.Empty,
                    Latitude = FormatLocationNumber(value?.Location?.Latitude),
                    Longitude = FormatLocationNumber(value?.Location?.Longitude),
                    LocationAccuracyMetres = FormatLocationNumber(value?.Location?.AccuracyMetres),
                    LocationRadiusKilometres = FormatLocationNumber(value?.Location?.ApproximationRadiusKilometres),
                };
            }).ToList();
    }

    private sealed class RecordModel
    {
        [Required, StringLength(300)]
        public string DisplayName { get; set; } = string.Empty;

        public string Aliases { get; set; } = string.Empty;
    }

    private string[] ParseAliases() => _model.Aliases
        .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static void SetScalar(EditorField editor, ChangeEventArgs args) =>
        editor.Scalar = args.Value?.ToString() ?? string.Empty;

    private static string FormatLocationNumber(double? value) =>
        value?.ToString("0.#######", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private sealed class EditorField
    {
        public required RecordTypeField Field { get; init; }
        public string Scalar { get; set; } = string.Empty;
        public string Tags { get; set; } = string.Empty;
        public TemporalPrecision TemporalPrecision { get; set; } = TemporalPrecision.Day;
        public bool IsApproximate { get; set; }
        public string ApproximationNote { get; set; } = string.Empty;
        public string LocationContext { get; set; } = string.Empty;
        public string Latitude { get; set; } = string.Empty;
        public string Longitude { get; set; } = string.Empty;
        public string LocationAccuracyMetres { get; set; } = string.Empty;
        public string LocationRadiusKilometres { get; set; } = string.Empty;
    }
}
