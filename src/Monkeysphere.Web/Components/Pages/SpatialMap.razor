@page "/map"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ISpatialMapService Maps
@inject IMonkeysphereService Records
@inject IMapSettingsService MapSettings

<PageTitle>Map · Monkeysphere</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">Places in context</p>
        <h1>Map</h1>
        <p>Explore records with known coordinates. External map tiles are disabled until you explicitly enable them.</p>
    </div>
</div>

<section class="panel map-filters" aria-label="Map filters">
    <div class="form-grid">
        <label>
            Record type
            <SearchableSelect TValue="string" Value="_recordTypeValue" Options="RecordTypeOptions" AriaLabel="Record type" OnSelected="RecordTypeChangedAsync" />
        </label>
        <fieldset class="map-layer-picker">
            <legend>Location layers <span class="muted">(none selected shows all)</span></legend>
            @foreach (FieldDefinition field in _locationFields)
            {
                <label>
                    <input type="checkbox"
                           checked="@_selectedFields.Contains(field.Id)"
                           @onchange="eventArgs => FieldChangedAsync(field.Id, eventArgs)" />
                    @LocationFieldLabel(field)
                </label>
            }
        </fieldset>
    </div>
</section>

<section class="panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Spatial view</p>
            <h2>Record locations</h2>
        </div>
        <span class="pill">@_results.TotalCount location@(_results.TotalCount == 1 ? string.Empty : "s")</span>
    </div>

    @if (_externalTilesEnabled)
    {
        <div class="notice warning map-privacy-notice">OpenStreetMap tiles are enabled. The viewed map area is shared with OpenStreetMap. <a href="/settings/map">Change map settings</a>.</div>
    }
    else
    {
        <div class="notice map-privacy-notice">External basemap tiles are off. The private coordinate grid is shown instead. <a href="/settings/map">Enable tiles in Settings</a>.</div>
    }

    @if (_results.Items.Count == 0)
    {
        <p class="empty-state">No records with coordinates match these filters.</p>
    }
    else
    {
        <SpatialRecordMap Entries="_results.Items" ExternalTilesEnabled="_externalTilesEnabled" />
        <div class="pagination" aria-label="Map result pages">
            <button class="button" type="button" disabled="@(_results.Page <= 1)" @onclick="PreviousPageAsync">Previous</button>
            <span>Page @_results.Page of @PageCount()</span>
            <button class="button" type="button" disabled="@(_results.Page >= PageCount())" @onclick="NextPageAsync">Next</button>
        </div>
    }
</section>

@code {
    private const int PageSize = 100;
    private IReadOnlyList<RecordType> _types = [];
    private IReadOnlyList<FieldDefinition> _locationFields = [];
    private PagedResult<SpatialMapEntry> _results = new([], 1, PageSize, 0);
    private string _recordTypeValue = string.Empty;
    private readonly HashSet<Guid> _selectedFields = [];
    private readonly Dictionary<Guid, List<string>> _locationFieldTypeNames = [];
    private int _page = 1;
    private bool _externalTilesEnabled;

    private IReadOnlyList<ComboboxOption<string>> RecordTypeOptions =>
        [new ComboboxOption<string>(string.Empty, "All record types"), .. _types.Select(type => new ComboboxOption<string>(type.Id.ToString(), type.Name))];

    protected override async Task OnInitializedAsync()
    {
        _externalTilesEnabled = (await MapSettings.GetAsync()).ExternalTilesEnabled;
        _types = await Records.ListRecordTypesAsync();
        await LoadLocationFieldsAsync();
        await ReloadAsync();
    }

    private async Task RecordTypeChangedAsync(string value)
    {
        _recordTypeValue = value;
        _selectedFields.Clear();
        _page = 1;
        await LoadLocationFieldsAsync();
        await ReloadAsync();
    }

    private async Task FieldChangedAsync(Guid fieldId, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is true)
        {
            _selectedFields.Add(fieldId);
        }
        else
        {
            _selectedFields.Remove(fieldId);
        }

        _page = 1;
        await ReloadAsync();
    }

    private async Task LoadLocationFieldsAsync()
    {
        _locationFieldTypeNames.Clear();
        IEnumerable<FieldDefinition> fields = SelectedRecordTypeId() is Guid typeId
            ? (await Records.GetRecordTypeAsync(typeId))?.Fields.Select(item => item.Definition) ?? []
            : await Records.ListFieldDefinitionsAsync();
        _locationFields = fields
            .Where(field => field.TypeId == FieldTypes.Location)
            .DistinctBy(field => field.Id)
            .OrderBy(field => field.Name, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();

        foreach (RecordType type in _types)
        {
            RecordTypeDetails? details = await Records.GetRecordTypeAsync(type.Id);
            foreach (Guid fieldId in details?.Fields
                         .Where(item => item.Definition.TypeId == FieldTypes.Location)
                         .Select(item => item.Definition.Id) ?? [])
            {
                if (!_locationFieldTypeNames.TryGetValue(fieldId, out List<string>? names))
                {
                    names = [];
                    _locationFieldTypeNames.Add(fieldId, names);
                }
                names.Add(type.Name);
            }
        }
    }

    private async Task ReloadAsync()
    {
        _results = await Maps.QueryAsync(new(
            RecordTypeId: SelectedRecordTypeId(),
            Page: _page,
            PageSize: PageSize,
            FieldDefinitionIds: _selectedFields.Order().ToArray()));
    }

    private async Task PreviousPageAsync()
    {
        _page = Math.Max(1, _page - 1);
        await ReloadAsync();
    }

    private async Task NextPageAsync()
    {
        _page = Math.Min(PageCount(), _page + 1);
        await ReloadAsync();
    }

    private int PageCount() => Math.Max(1, (int)Math.Ceiling(_results.TotalCount / (double)PageSize));

    private Guid? SelectedRecordTypeId() =>
        Guid.TryParse(_recordTypeValue, out Guid recordTypeId) ? recordTypeId : null;

    private string LocationFieldLabel(FieldDefinition field) =>
        _locationFieldTypeNames.TryGetValue(field.Id, out List<string>? names)
            ? $"{field.Name} · {string.Join(", ", names)}"
            : field.Name;
}
