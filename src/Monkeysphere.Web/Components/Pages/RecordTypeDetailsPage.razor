@page "/record-types/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IMonkeysphereService Service

<PageTitle>@(_details?.RecordType.Name ?? "Record type") · Monkeysphere</PageTitle>

@if (_loading)
{
    <p>Loading…</p>
}
else if (_details is null)
{
    <h1>Record type not found</h1>
    <p><a href="/record-types">Return to record types</a></p>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Record type</p>
            <h1>@_details.RecordType.Name</h1>
            <p class="muted">Stable ID @_details.RecordType.Id - @_details.RecordType.Lifecycle</p>
        </div>
        @if (_details.RecordType.Lifecycle == RecordTypeLifecycle.Active)
        {
            <a class="button" href="/records/new?typeId=@Id">Add record</a>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="notice @(_isError ? "error" : "success")" role="status">@_message</div>
    }

    <section class="panel">
        <h2>Type lifecycle</h2>
        <p class="muted">Retirement preserves existing records. Merging moves records and saved views into another active type while retaining this type as retired history.</p>
        <div class="settings-grid">
            <div class="settings-card">
                <h3>Retire this type</h3>
                @if (_details.RecordType.Lifecycle == RecordTypeLifecycle.Retired)
                {
                    <p>This record type is retired. Existing records remain editable, but new records and field attachments are blocked.</p>
                }
                else
                {
                    <button class="button" type="button" @onclick="PreviewTypeRetirementAsync">Preview retirement</button>
                    @if (_retirementPreview is not null)
                    {
                        <div class="operation-preview">
                            <h4>Retirement preview</h4>
                            <ul>
                                <li>@_retirementPreview.RecordCount existing record(s) remain on this type</li>
                                <li>@_retirementPreview.SavedViewCount saved view(s) remain available</li>
                            </ul>
                            <label class="checkbox-label">
                                <InputCheckbox @bind-Value="_retirementConfirmed" />
                                I reviewed this preview and want to retire the type.
                            </label>
                            <button class="button danger" type="button" @onclick="ApplyTypeRetirementAsync">Retire type</button>
                        </div>
                    }
                }
            </div>

            <div class="settings-card">
                <h3>Merge into another type</h3>
                <label>
                    Active target type
                    <SearchableSelect TValue="string" @bind-Value="_typeMergeTargetId" Options="TypeMergeTargetOptions" AriaLabel="Active target type" />
                </label>
                <button class="button" type="button" @onclick="PreviewTypeMergeAsync">Preview type merge</button>
                @if (_typeMergePreview is not null)
                {
                    <div class="operation-preview">
                        <h4>Type merge preview</h4>
                        <p><strong>@_typeMergePreview.Source.Name</strong> will merge into <strong>@_typeMergePreview.Target.Name</strong>.</p>
                        <ul>
                            <li>@_typeMergePreview.SourceRecordCount record(s) move; @_typeMergePreview.TargetRecordCount already use the target</li>
                            <li>@_typeMergePreview.SourceSavedViewCount saved view(s) move</li>
                            <li>@_typeMergePreview.SharedFieldCount shared field attachment(s)</li>
                            <li>@_typeMergePreview.AddedFieldCount source-only field(s) append as optional</li>
                            <li>@_typeMergePreview.RequiredDowngradeCount required rule(s) become optional to preserve existing record validity</li>
                        </ul>
                        <p class="muted">The target keeps its stable identity and preset provenance. This source type remains as retired history.</p>
                        <label class="checkbox-label">
                            <InputCheckbox @bind-Value="_typeMergeConfirmed" />
                            I reviewed this preview and want to apply the type merge transactionally.
                        </label>
                        <button class="button danger" type="button" @onclick="ApplyTypeMergeAsync">Apply type merge</button>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="panel">
        <h2>Rename type</h2>
        <EditForm Model="_rename" OnValidSubmit="RenameAsync">
            <DataAnnotationsValidator />
            <label>
                Name
                <InputText @bind-Value="_rename.Name" />
                <ValidationMessage For="() => _rename.Name" />
            </label>
            <button class="button" type="submit">Save name</button>
        </EditForm>
    </section>

    @if (_details.RecordType.Lifecycle == RecordTypeLifecycle.Active)
    {
    <section class="panel">
        <h2>Add a field</h2>
        <EditForm Model="_newField" OnValidSubmit="AddFieldAsync">
            <DataAnnotationsValidator />
            <div class="form-grid">
                <label>
                    Field name
                    <InputText @bind-Value="_newField.Name" />
                    <ValidationMessage For="() => _newField.Name" />
                </label>
                <label>
                    Type identifier
                    <SearchableSelect TValue="string" @bind-Value="_newField.TypeId" Options="FieldTypeOptions" AriaLabel="Type identifier" AllowCustomValue="true" Required="true" />
                    <ValidationMessage For="() => _newField.TypeId" />
                </label>
            </div>
            @if (string.Equals(_newField.TypeId, FieldTypes.Choice, StringComparison.OrdinalIgnoreCase))
            {
                <label>
                    Choices (one per line)
                    <InputTextArea @bind-Value="_newField.Choices" rows="5" />
                </label>
            }
            <label class="checkbox-label">
                <InputCheckbox @bind-Value="_newField.IsRequired" />
                Required on every record
            </label>
            <button class="button primary" type="submit">Add field</button>
        </EditForm>
    </section>

    <section class="panel">
        <h2>Reuse an existing field</h2>
        @if (AvailableDefinitions.Count == 0)
        {
            <p class="empty-state">There are no other active field definitions to attach.</p>
        }
        else
        {
            <EditForm Model="_existingField" OnValidSubmit="AttachExistingAsync">
                <DataAnnotationsValidator />
                <label>
                    Field definition
                    <SearchableSelect TValue="string" @bind-Value="_existingField.FieldDefinitionId" Options="AvailableDefinitionOptions" AriaLabel="Field definition" Required="true" />
                </label>
                <label class="checkbox-label">
                    <InputCheckbox @bind-Value="_existingField.IsRequired" />
                    Required on every record of this type
                </label>
                <button class="button" type="submit">Attach existing field</button>
            </EditForm>
        }
    </section>
    }

    <section class="panel">
        <h2>Fields</h2>
        @if (_details.Fields.Count == 0)
        {
            <p class="empty-state">This type has no fields yet.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Field</th><th>Type</th><th>Required</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (RecordTypeField field in _details.Fields)
                        {
                            <tr>
                                <td>
                                    @if (field.Definition.Lifecycle == FieldLifecycle.Active)
                                    {
                                        <input value="@FieldName(field.Definition)" aria-label="Rename @field.Definition.Name"
                                               @onchange="args => SetFieldName(field.Definition.Id, args)" />
                                    }
                                    else
                                    {
                                        @field.Definition.Name
                                    }
                                </td>
                                <td><code>@field.Definition.TypeId</code></td>
                                <td>@(field.IsRequired ? "Yes" : "No")</td>
                                <td>@field.Definition.Lifecycle</td>
                                <td>
                                    @if (field.Definition.Lifecycle == FieldLifecycle.Active)
                                    {
                                        <button class="button subtle" type="button" @onclick="() => RenameFieldAsync(field.Definition)">Rename</button>
                                        <button class="button danger subtle" type="button" @onclick="() => RetireAsync(field.Definition)">Retire</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="panel">
        <h2>Evolve field definitions</h2>
        <p class="muted">Preview every affected attachment, value, and saved-view reference before changing a shared field definition.</p>

        <div class="settings-grid">
            <div class="settings-card">
                <h3>Merge compatible fields</h3>
                <p class="muted">The source is retired after its references move to an active target with exactly the same type and configuration.</p>
                <EditForm Model="_merge" OnValidSubmit="PreviewMergeAsync">
                    <DataAnnotationsValidator />
                    <label>
                        Source field
                        <SearchableSelect TValue="string" @bind-Value="_merge.SourceId" Options="SourceDefinitionOptions" AriaLabel="Source field" Required="true" />
                    </label>
                    <label>
                        Target field
                        <SearchableSelect TValue="string" @bind-Value="_merge.TargetId" Options="TargetDefinitionOptions" AriaLabel="Target field" Required="true" />
                    </label>
                    <label>
                        If a record contains both fields
                        <SearchableSelect TValue="FieldMergeConflictResolution" @bind-Value="_merge.Resolution" Options="ConflictResolutionOptions" AriaLabel="Merge conflict resolution" />
                    </label>
                    <button class="button" type="submit">Preview merge</button>
                </EditForm>

                @if (_mergePreview is not null)
                {
                    <div class="operation-preview">
                        <h4>Merge preview</h4>
                        <p><strong>@_mergePreview.Source.Name</strong> will merge into <strong>@_mergePreview.Target.Name</strong>.</p>
                        <ul>
                            <li>@_mergePreview.SourceAttachmentCount record-type attachment(s)</li>
                            <li>@_mergePreview.SourceValueCount stored value(s)</li>
                            <li>@_mergePreview.ConflictingValueCount record conflict(s)</li>
                            <li>@_mergePreview.SavedViewReferenceCount saved-view reference(s)</li>
                        </ul>
                        @if (!_mergePreview.IsCompatible)
                        {
                            <p class="validation-message">@_mergePreview.IncompatibilityReason</p>
                        }
                        else
                        {
                            <label class="checkbox-label">
                                <InputCheckbox @bind-Value="_merge.Confirmed" />
                                I reviewed this preview and want to apply the merge transactionally.
                            </label>
                            <button class="button danger" type="button" @onclick="ApplyMergeAsync">Apply merge</button>
                        }
                    </div>
                }
            </div>

            <div class="settings-card">
                <h3>Convert a field</h3>
                <p class="muted">A conversion creates a new local definition and moves references only when every existing value validates safely.</p>
                <EditForm Model="_conversion" OnValidSubmit="PreviewConversionAsync">
                    <DataAnnotationsValidator />
                    <label>
                        Source field
                        <SearchableSelect TValue="string" @bind-Value="_conversion.SourceId" Options="ConversionSourceOptions" AriaLabel="Source field" Required="true" />
                    </label>
                    <label>
                        New field name
                        <InputText @bind-Value="_conversion.Name" />
                        <ValidationMessage For="() => _conversion.Name" />
                    </label>
                    <label>
                        New type identifier
                        <SearchableSelect TValue="string" @bind-Value="_conversion.TypeId" Options="FieldTypeOptions" AriaLabel="New type identifier" AllowCustomValue="true" Required="true" />
                        <ValidationMessage For="() => _conversion.TypeId" />
                    </label>
                    @if (string.Equals(_conversion.TypeId, FieldTypes.Choice, StringComparison.OrdinalIgnoreCase))
                    {
                        <label>
                            Choices (one per line)
                            <InputTextArea @bind-Value="_conversion.Choices" rows="5" />
                        </label>
                    }
                    <button class="button" type="submit">Preview conversion</button>
                </EditForm>

                @if (_conversionPreview is not null)
                {
                    <div class="operation-preview">
                        <h4>Conversion preview</h4>
                        <p><strong>@_conversionPreview.Source.Name</strong> will become a new <code>@_conversionPreview.TargetTypeId</code> field named <strong>@_conversionPreview.TargetName</strong>.</p>
                        <ul>
                            <li>@_conversionPreview.AttachmentCount record-type attachment(s)</li>
                            <li>@_conversionPreview.ValueCount stored value(s)</li>
                            <li>@_conversionPreview.SavedViewReferenceCount saved-view reference(s)</li>
                            <li>@_conversionPreview.FailedValueCount value(s) that cannot convert safely</li>
                        </ul>
                        @if (_conversionPreview.FailedValueCount > 0)
                        {
                            <p class="validation-message">Correct the incompatible values or choose a different target type, then preview again.</p>
                            <ul>
                                @foreach (FieldConversionIssue issue in _conversionPreview.Issues)
                                {
                                    <li><strong>@issue.RecordDisplayName:</strong> @issue.Reason</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <label class="checkbox-label">
                                <InputCheckbox @bind-Value="_conversion.Confirmed" />
                                I reviewed this preview and want to create the new definition and migrate all references transactionally.
                            </label>
                            <button class="button danger" type="button" @onclick="ApplyConversionAsync">Apply conversion</button>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private RecordTypeDetails? _details;
    private readonly RenameModel _rename = new();
    private readonly NewFieldModel _newField = new();
    private readonly ExistingFieldModel _existingField = new();
    private readonly MergeFieldModel _merge = new();
    private readonly ConvertFieldModel _conversion = new();
    private IReadOnlyList<RecordType> _recordTypes = [];
    private IReadOnlyList<FieldDefinition> _definitions = [];
    private readonly Dictionary<Guid, string> _fieldNames = [];
    private string? _message;
    private bool _isError;
    private FieldMergePreview? _mergePreview;
    private FieldConversionPreview? _conversionPreview;
    private RecordTypeRetirementPreview? _retirementPreview;
    private RecordTypeMergePreview? _typeMergePreview;
    private bool _retirementConfirmed;
    private bool _typeMergeConfirmed;
    private string _typeMergeTargetId = string.Empty;

    private IReadOnlyList<ComboboxOption<string>> TypeMergeTargetOptions =>
        [new ComboboxOption<string>(string.Empty, "Choose the type to keep"), .. TypeMergeTargets.Select(type => new ComboboxOption<string>(type.Id.ToString(), type.Name))];

    private static IReadOnlyList<ComboboxOption<string>> FieldTypeOptions { get; } =
        [.. FieldTypes.Recognized.Select(typeId => new ComboboxOption<string>(typeId, typeId))];

    private IReadOnlyList<ComboboxOption<string>> AvailableDefinitionOptions =>
        [new ComboboxOption<string>(string.Empty, "Choose a field"), .. AvailableDefinitions.Select(definition => new ComboboxOption<string>(definition.Id.ToString(), $"{definition.Name} ({definition.TypeId})"))];

    private IReadOnlyList<ComboboxOption<string>> SourceDefinitionOptions =>
        [new ComboboxOption<string>(string.Empty, "Choose the field to retire"), .. _definitions.Select(definition => new ComboboxOption<string>(definition.Id.ToString(), $"{definition.Name} ({definition.TypeId}, {definition.Lifecycle})"))];

    private IReadOnlyList<ComboboxOption<string>> TargetDefinitionOptions =>
        [new ComboboxOption<string>(string.Empty, "Choose the field to keep"), .. _definitions.Where(item => item.Lifecycle == FieldLifecycle.Active).Select(definition => new ComboboxOption<string>(definition.Id.ToString(), $"{definition.Name} ({definition.TypeId})"))];

    private IReadOnlyList<ComboboxOption<string>> ConversionSourceOptions =>
        [new ComboboxOption<string>(string.Empty, "Choose a field"), .. _definitions.Select(definition => new ComboboxOption<string>(definition.Id.ToString(), $"{definition.Name} ({definition.TypeId}, {definition.Lifecycle})"))];

    private static IReadOnlyList<ComboboxOption<FieldMergeConflictResolution>> ConflictResolutionOptions { get; } =
    [
        new(FieldMergeConflictResolution.Reject, "Stop without changing anything"),
        new(FieldMergeConflictResolution.KeepTarget, "Keep the target value"),
        new(FieldMergeConflictResolution.KeepSource, "Keep the source value"),
    ];

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task RenameAsync() => await RunAsync(async () =>
    {
        await Service.RenameRecordTypeAsync(Id, _rename.Name);
        _message = "Record type renamed.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task AddFieldAsync() => await RunAsync(async () =>
    {
        string[]? choices = string.Equals(_newField.TypeId, FieldTypes.Choice, StringComparison.OrdinalIgnoreCase)
            ? _newField.Choices.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            : null;
        await Service.CreateAndAttachFieldAsync(Id, new CreateFieldRequest(
            _newField.Name,
            _newField.TypeId,
            _newField.IsRequired,
            choices));
        _newField.Name = string.Empty;
        _newField.TypeId = FieldTypes.Text;
        _newField.Choices = string.Empty;
        _newField.IsRequired = false;
        _message = "Field added.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task RetireAsync(FieldDefinition definition) => await RunAsync(async () =>
    {
        await Service.RetireFieldAsync(definition.Id);
        _message = $"Retired {definition.Name}. Existing values remain preserved.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task AttachExistingAsync() => await RunAsync(async () =>
    {
        if (!Guid.TryParse(_existingField.FieldDefinitionId, out Guid fieldDefinitionId))
        {
            throw new DomainValidationException("Choose an active field definition.");
        }

        await Service.AttachFieldAsync(Id, fieldDefinitionId, _existingField.IsRequired);
        _existingField.FieldDefinitionId = string.Empty;
        _existingField.IsRequired = false;
        _message = "Existing field attached with its stable identity preserved.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task RenameFieldAsync(FieldDefinition definition) => await RunAsync(async () =>
    {
        await Service.RenameFieldAsync(definition.Id, FieldName(definition));
        _message = "Field definition renamed everywhere it is reused.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task PreviewTypeRetirementAsync() => await RunAsync(async () =>
    {
        _retirementPreview = await Service.PreviewRecordTypeRetirementAsync(Id);
        _retirementConfirmed = false;
        _message = "Retirement preview is ready. Existing records and views will remain available.";
    });

    private async Task ApplyTypeRetirementAsync() => await RunAsync(async () =>
    {
        if (!_retirementConfirmed || _retirementPreview is null)
        {
            throw new DomainValidationException("Review and confirm the retirement preview first.");
        }

        await Service.RetireRecordTypeAsync(Id, _retirementPreview.Revision);
        _message = "Record type retired. Existing records remain editable.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task PreviewTypeMergeAsync() => await RunAsync(async () =>
    {
        Guid targetId = TypeMergeTargetId();
        _typeMergePreview = await Service.PreviewRecordTypeMergeAsync(Id, targetId);
        _typeMergeConfirmed = false;
        _message = "Type merge preview is ready. Review field and requiredness changes before applying.";
    });

    private async Task ApplyTypeMergeAsync() => await RunAsync(async () =>
    {
        if (!_typeMergeConfirmed || _typeMergePreview is null)
        {
            throw new DomainValidationException("Review and confirm the type merge preview first.");
        }

        Guid targetId = TypeMergeTargetId();
        if (_typeMergePreview.Source.Id != Id || _typeMergePreview.Target.Id != targetId)
        {
            throw new DomainValidationException("The selected target changed. Preview the type merge again.");
        }

        await Service.MergeRecordTypesAsync(Id, targetId, _typeMergePreview.Revision);
        _message = $"Merged this type into {_typeMergePreview.Target.Name}. This source type is now retired.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task PreviewMergeAsync() => await RunAsync(async () =>
    {
        (Guid sourceId, Guid targetId) = MergeIds();
        _mergePreview = await Service.PreviewFieldMergeAsync(sourceId, targetId);
        _merge.Confirmed = false;
        _message = _mergePreview.IsCompatible
            ? "Merge preview is ready. Review conflicts and confirm before applying."
            : _mergePreview.IncompatibilityReason;
    });

    private async Task ApplyMergeAsync() => await RunAsync(async () =>
    {
        if (!_merge.Confirmed || _mergePreview is null)
        {
            throw new DomainValidationException("Review and confirm the merge preview first.");
        }

        (Guid sourceId, Guid targetId) = MergeIds();
        if (_mergePreview.Source.Id != sourceId || _mergePreview.Target.Id != targetId)
        {
            throw new DomainValidationException("The selected fields changed. Preview the merge again.");
        }

        await Service.MergeFieldsAsync(sourceId, targetId, _merge.Resolution, _mergePreview.Revision);
        _message = $"Merged {_mergePreview.Source.Name} into {_mergePreview.Target.Name}. The source definition is retired.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task PreviewConversionAsync() => await RunAsync(async () =>
    {
        Guid sourceId = ConversionSourceId();
        _conversionPreview = await Service.PreviewFieldConversionAsync(sourceId, ConversionRequest());
        _conversion.Confirmed = false;
        _message = _conversionPreview.FailedValueCount == 0
            ? "Conversion preview is ready. Every existing value can be represented safely."
            : $"Conversion is blocked by {_conversionPreview.FailedValueCount} incompatible value(s).";
    });

    private async Task ApplyConversionAsync() => await RunAsync(async () =>
    {
        if (!_conversion.Confirmed || _conversionPreview is null)
        {
            throw new DomainValidationException("Review and confirm the conversion preview first.");
        }

        Guid sourceId = ConversionSourceId();
        ConvertFieldRequest request = ConversionRequest();
        string typeId = FieldTypes.NormalizeTypeId(request.TypeId);
        string configuration = FieldTypes.NormalizeConfiguration(typeId, request.ChoiceOptions);
        if (_conversionPreview.Source.Id != sourceId ||
            !string.Equals(_conversionPreview.TargetName, request.Name.Trim(), StringComparison.Ordinal) ||
            !string.Equals(_conversionPreview.TargetTypeId, typeId, StringComparison.Ordinal) ||
            !string.Equals(_conversionPreview.TargetConfigurationJson, configuration, StringComparison.Ordinal))
        {
            throw new DomainValidationException("The conversion settings changed. Preview the conversion again.");
        }

        FieldDefinition target = await Service.ConvertFieldAsync(sourceId, request, _conversionPreview.Revision);
        _message = $"Converted {_conversionPreview.Source.Name} into the new {target.Name} definition. The source definition is retired.";
        await ReloadAsync(preserveMessage: true);
    });

    private async Task ReloadAsync(bool preserveMessage = false)
    {
        _details = await Service.GetRecordTypeAsync(Id);
        _recordTypes = await Service.ListRecordTypesAsync();
        _definitions = await Service.ListFieldDefinitionsAsync();
        _mergePreview = null;
        _conversionPreview = null;
        _retirementPreview = null;
        _typeMergePreview = null;
        if (_details is not null)
        {
            _rename.Name = _details.RecordType.Name;
            foreach (RecordTypeField field in _details.Fields)
            {
                _fieldNames[field.Definition.Id] = field.Definition.Name;
            }
        }

        if (!preserveMessage)
        {
            _message = null;
        }

        _loading = false;
    }

    private IReadOnlyList<FieldDefinition> AvailableDefinitions => _details is null
        ? []
        : _definitions
            .Where(definition => definition.Lifecycle == FieldLifecycle.Active &&
                _details.Fields.All(attachment => attachment.Definition.Id != definition.Id))
            .ToArray();

    private IReadOnlyList<RecordType> TypeMergeTargets => _recordTypes
        .Where(type => type.Id != Id && type.Lifecycle == RecordTypeLifecycle.Active)
        .ToArray();

    private string FieldName(FieldDefinition definition) =>
        _fieldNames.GetValueOrDefault(definition.Id, definition.Name);

    private void SetFieldName(Guid id, ChangeEventArgs args) =>
        _fieldNames[id] = args.Value?.ToString() ?? string.Empty;

    private (Guid SourceId, Guid TargetId) MergeIds()
    {
        if (!Guid.TryParse(_merge.SourceId, out Guid sourceId) || !Guid.TryParse(_merge.TargetId, out Guid targetId))
        {
            throw new DomainValidationException("Choose both a source and target field definition.");
        }

        return (sourceId, targetId);
    }

    private Guid ConversionSourceId() => Guid.TryParse(_conversion.SourceId, out Guid sourceId)
        ? sourceId
        : throw new DomainValidationException("Choose a source field definition.");

    private Guid TypeMergeTargetId() => Guid.TryParse(_typeMergeTargetId, out Guid targetId)
        ? targetId
        : throw new DomainValidationException("Choose an active target record type.");

    private ConvertFieldRequest ConversionRequest()
    {
        string[]? choices = string.Equals(_conversion.TypeId, FieldTypes.Choice, StringComparison.OrdinalIgnoreCase)
            ? _conversion.Choices.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            : null;
        return new ConvertFieldRequest(_conversion.Name, _conversion.TypeId, choices);
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            _isError = false;
            await action();
        }
        catch (Exception exception) when (exception is DomainValidationException or InvalidOperationException)
        {
            _message = exception.Message;
            _isError = true;
        }
    }

    private sealed class RenameModel
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;
    }

    private sealed class NewFieldModel
    {
        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string TypeId { get; set; } = FieldTypes.Text;

        public bool IsRequired { get; set; }

        public string Choices { get; set; } = string.Empty;
    }

    private sealed class ExistingFieldModel
    {
        public string FieldDefinitionId { get; set; } = string.Empty;

        public bool IsRequired { get; set; }
    }

    private sealed class MergeFieldModel
    {
        public string SourceId { get; set; } = string.Empty;

        public string TargetId { get; set; } = string.Empty;

        public FieldMergeConflictResolution Resolution { get; set; } = FieldMergeConflictResolution.Reject;

        public bool Confirmed { get; set; }
    }

    private sealed class ConvertFieldModel
    {
        public string SourceId { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required, StringLength(100)]
        public string TypeId { get; set; } = FieldTypes.Text;

        public string Choices { get; set; } = string.Empty;

        public bool Confirmed { get; set; }
    }
}
