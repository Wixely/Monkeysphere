@page "/backups"
@page "/settings/backups"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@inject IBackupService BackupService
@inject IOptions<BackupScheduleOptions> ScheduleOptions

<PageTitle>Backups · Monkeysphere</PageTitle>

<SettingsTabs Active="backups" />

<div class="page-heading">
    <div>
        <p class="eyebrow">Portable recovery</p>
        <h1>Backups</h1>
        <p>Create a checksummed package containing consistent database snapshots and authoritative image originals.</p>
    </div>
    <button class="button primary" type="button" disabled="@_working" @onclick="CreateAsync">@(_working ? "Creating…" : "Create backup")</button>
</div>

<div class="notice" role="note">
    Backups exclude deployment configuration, data-protection keys, administrator credentials, and regenerable image derivatives. Store downloaded packages as sensitive personal data.
</div>

<section class="panel">
    <p class="eyebrow">Automatic schedule</p>
    <h2>@ScheduleSummary()</h2>
    <p>Configure the schedule through deployment settings. Completed scheduled backups retain the newest @ScheduleOptions.Value.RetentionCount package@((ScheduleOptions.Value.RetentionCount == 1) ? string.Empty : "s").</p>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="notice @(_isError ? "error" : "success")" role="status">@_message</div>
}

<section class="panel">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Verified packages</p>
            <h2>Available backups</h2>
        </div>
    </div>

    @if (_backups.Count == 0)
    {
        <p class="empty-state">No backups have been created yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead><tr><th>Created</th><th>Size</th><th>Package</th><th></th></tr></thead>
                <tbody>
                    @foreach (BackupInfo backup in _backups)
                    {
                        <tr>
                            <td>@backup.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td>@FormatSize(backup.ByteLength)</td>
                            <td><code>@backup.FileName</code></td>
                            <td><a class="button" href="/backups/@backup.Id/download">Download</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<BackupInfo> _backups = [];
    private bool _working;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync() => _backups = await BackupService.ListAsync();

    private async Task CreateAsync()
    {
        _working = true;
        _message = null;
        try
        {
            BackupInfo backup = await BackupService.CreateAsync();
            _backups = await BackupService.ListAsync();
            _message = $"Created and verified {backup.FileName}.";
            _isError = false;
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or UnauthorizedAccessException)
        {
            _message = exception.Message;
            _isError = true;
        }
        finally
        {
            _working = false;
        }
    }

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824d:0.##} GB",
        >= 1_048_576 => $"{bytes / 1_048_576d:0.##} MB",
        >= 1_024 => $"{bytes / 1_024d:0.##} KB",
        _ => $"{bytes} B",
    };

    private string ScheduleSummary()
    {
        BackupScheduleOptions schedule = ScheduleOptions.Value;
        if (string.Equals(schedule.Frequency, "Off", StringComparison.OrdinalIgnoreCase))
        {
            return "Scheduled backups are off";
        }

        return $"{schedule.Frequency} at {schedule.Time:HH:mm} ({schedule.TimeZone})";
    }
}
