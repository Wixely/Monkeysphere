@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="relationship-graph-shell">
    <div class="relationship-graph"
         @ref="_element"
         role="img"
         tabindex="0"
         aria-label="Relationship graph visualization. Select a record to view its images. Shift-drag to select several records and drag a selected record to move the group. Control-click toggles records in the selection. Right-click or long-press a record for actions."
         aria-describedby="relationship-graph-description"></div>
    <div class="graph-type-badges" aria-hidden="true"></div>
    <div class="graph-multi-selection" role="status" aria-live="polite" hidden></div>
</div>

@code {
    [Parameter]
    public RelationshipGraphResult Graph { get; set; } = new([], [], false, false);

    [Parameter]
    public IReadOnlyList<GraphViewNodePosition> NodePositions { get; set; } = [];

    [Parameter]
    public GraphViewViewport? Viewport { get; set; }

    [Parameter]
    public EventCallback<Guid> OnNodeSelected { get; set; }

    [Parameter]
    public EventCallback OnGraphChanged { get; set; }

    /// <summary>
    /// Raised when the canvas is asked for a context menu, on a record or on empty space. The
    /// menu is rendered by the page rather than here: it carries record types, tags and controls,
    /// which is a user interface, and the canvas only knows where and on what it was asked for.
    /// </summary>
    [Parameter]
    public EventCallback<ContextMenuRequest> OnContextMenuRequested { get; set; }

    [Parameter]
    public EventCallback OnContextMenuDismissed { get; set; }

    /// <summary>
    /// Whether records being placed or moved are nudged clear of one another. Changing it never
    /// rearranges what is already on the canvas: it governs the next placement, not the last one.
    /// </summary>
    [Parameter]
    public bool KeepRecordsApart { get; set; } = true;

    /// <summary>Where a newly created record should appear, in canvas coordinates.</summary>
    [Parameter]
    public GraphNodePlacement? Placement { get; set; }

    [Parameter]
    public Guid? CenterRecordId { get; set; }

    [Parameter]
    public long CenterRequest { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RelationshipGraphCanvas>? _reference;
    private string _revision = string.Empty;
    private bool _needsUpdate;
    private long _completedCenterRequest;
    private long _completedPlacement;
    private bool? _appliedKeepApart;

    protected override void OnParametersSet()
    {
        string revision = string.Join('|', Graph.Nodes.Select(node => $"{node.RecordId}:{node.DisplayName}:{node.RecordTypeName}:{node.Distance}:{node.ImageId}:{node.RecordTypeSymbol}")) + ":" +
            string.Join('|', Graph.Edges.Select(edge => $"{edge.RelationshipId}:{edge.SourceRecordId}:{edge.TargetRecordId}:{edge.Label}:{edge.IsExpired}")) + ":" +
            string.Join('|', NodePositions.Select(position => $"{position.RecordId}:{position.X}:{position.Y}")) + ":" +
            $"{Viewport?.PanX}:{Viewport?.PanY}:{Viewport?.Zoom}";
        _needsUpdate = !string.Equals(revision, _revision, StringComparison.Ordinal);
        _revision = revision;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./relationship-graph.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _element, _reference, Graph, NodePositions, Viewport, KeepRecordsApart);
            _appliedKeepApart = KeepRecordsApart;
            _needsUpdate = false;
        }
        else if (_needsUpdate && _module is not null)
        {
            GraphNodePlacement? placement = Placement is { } pending && pending.Request != _completedPlacement
                ? pending
                : null;
            await _module.InvokeVoidAsync("update", _element, Graph, NodePositions, placement);
            if (placement is not null)
            {
                _completedPlacement = placement.Request;
            }

            _needsUpdate = false;
        }

        // Pushed on its own rather than folded into the revision, because a change here must not
        // trigger a relayout: turning spacing off is not a request to rearrange the canvas.
        if (_module is not null && _appliedKeepApart != KeepRecordsApart)
        {
            await _module.InvokeVoidAsync("setKeepApart", _element, KeepRecordsApart);
            _appliedKeepApart = KeepRecordsApart;
        }

        if (_module is not null && CenterRecordId.HasValue && CenterRequest != _completedCenterRequest)
        {
            await _module.InvokeVoidAsync("centerOn", _element, CenterRecordId.Value.ToString("D"));
            _completedCenterRequest = CenterRequest;
        }
    }

    [JSInvokable]
    public Task NodeSelected(string recordId) =>
        Guid.TryParse(recordId, out Guid parsed)
            ? OnNodeSelected.InvokeAsync(parsed)
            : Task.CompletedTask;

    [JSInvokable]
    public Task GraphChanged() => OnGraphChanged.InvokeAsync();

    /// <summary>
    /// A null <paramref name="recordId"/> means empty canvas. <paramref name="recordIds"/> is what
    /// the menu should act on: the whole selection when the pointer was inside it, and the one
    /// record it was pointing at when it was not.
    /// </summary>
    [JSInvokable]
    public Task ContextMenuRequested(string? recordId, string[] recordIds, int x, int y) =>
        OnContextMenuRequested.InvokeAsync(new(
            Guid.TryParse(recordId, out Guid parsed) ? parsed : null,
            [.. recordIds.Select(value => Guid.TryParse(value, out Guid id) ? id : Guid.Empty).Where(id => id != Guid.Empty)],
            x,
            y));

    [JSInvokable]
    public Task ContextMenuDismissed() => OnContextMenuDismissed.InvokeAsync();

    /// <summary>Where the canvas was asked for a menu, and what the menu should act on.</summary>
    public sealed record ContextMenuRequest(Guid? RecordId, IReadOnlyList<Guid> RecordIds, int X, int Y);

    /// <summary>
    /// A record to drop at a point of the canvas. <paramref name="Request"/> makes it one-shot, so
    /// a later redraw does not move the record back to where it was first put.
    /// </summary>
    /// <param name="X">Canvas x, as the context menu reported it.</param>
    public sealed record GraphNodePlacement(string RecordId, int X, int Y, long Request);

    public async Task<IReadOnlyList<GraphViewNodePosition>> CaptureNodePositionsAsync()
    {
        if (_module is null)
        {
            return [];
        }

        return await _module.InvokeAsync<GraphViewNodePosition[]>("getPositions", _element);
    }

    public async Task<GraphViewViewport?> CaptureViewportAsync() =>
        _module is null
            ? null
            : await _module.InvokeAsync<GraphViewViewport?>("getViewport", _element);

    /// <summary>Frames every node in whatever space the canvas now has.</summary>
    public async Task FitAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("fitToElement", _element);
        }
    }

    /// <summary>Puts back a viewport captured earlier, once the canvas has its size again.</summary>
    public async Task RestoreViewportAsync(GraphViewViewport? viewport)
    {
        if (_module is not null && viewport is not null)
        {
            await _module.InvokeVoidAsync("restoreViewport", _element, viewport);
        }
    }

    public async Task ResetViewportAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("resetViewport", _element);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }
}
