@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="relationship-graph" @ref="_element" aria-label="Relationship graph"></div>

@code {
    [Parameter]
    public RelationshipGraphResult Graph { get; set; } = new([], [], false, false);

    [Parameter]
    public EventCallback<Guid> OnNodeSelected { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<RelationshipGraphCanvas>? _reference;
    private string _revision = string.Empty;
    private bool _needsUpdate;

    protected override void OnParametersSet()
    {
        string revision = string.Join('|', Graph.Nodes.Select(node => $"{node.RecordId}:{node.DisplayName}:{node.RecordTypeName}:{node.Distance}")) + ":" +
            string.Join('|', Graph.Edges.Select(edge => $"{edge.RelationshipId}:{edge.SourceRecordId}:{edge.TargetRecordId}:{edge.Label}"));
        _needsUpdate = !string.Equals(revision, _revision, StringComparison.Ordinal);
        _revision = revision;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./relationship-graph.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _element, _reference, Graph);
            _needsUpdate = false;
        }
        else if (_needsUpdate && _module is not null)
        {
            await _module.InvokeVoidAsync("update", _element, Graph);
            _needsUpdate = false;
        }
    }

    [JSInvokable]
    public Task NodeSelected(string recordId) =>
        Guid.TryParse(recordId, out Guid parsed)
            ? OnNodeSelected.InvokeAsync(parsed)
            : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }
}
