@inherits LayoutComponentBase

<header class="site-header">
    <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">m</span>
        <span>Monkeysphere</span>
    </a>
    <AuthorizeView>
        <Authorized>
            <nav aria-label="Primary navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
                <NavLink href="/record-types">Record types</NavLink>
                <NavLink href="/relationship-types">Relationship types</NavLink>
                <NavLink href="/records">Records</NavLink>
                <NavLink href="/saved-views">Saved views</NavLink>
                <NavLink href="/remote-access">Remote access</NavLink>
            </nav>
            <form method="post" action="/auth/logout" class="logout-form">
                <AntiforgeryToken />
                <button type="submit" class="button-link">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>

<main class="page-shell">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href=".">Reload</a>
</div>
