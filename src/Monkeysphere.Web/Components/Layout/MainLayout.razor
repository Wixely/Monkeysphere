@inherits LayoutComponentBase
@inject IPresetService Presets
@inject IDomainCatalog Domains
@inject ICurrentDomain CurrentDomain
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="site-header">
    <a class="brand" href="/">
        <img class="brand-mark" src="@Assets["favicon.svg"]" alt="" />
        <span>Monkeysphere</span>
    </a>
    <AuthorizeView>
        <Authorized>
            <nav aria-label="Primary navigation">
                <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="/structures">Structures</NavLink>
                <NavLink href="/records">Records</NavLink>
                <NavLink href="/calendar">Calendar</NavLink>
                <NavLink href="/map">Map</NavLink>
                <NavLink href="/graph">Graph</NavLink>
                <NavLink href="/settings">Settings</NavLink>
            </nav>
        </Authorized>
    </AuthorizeView>
    <AuthorizeView>
        <Authorized>
            <details class="domain-switcher">
                <summary aria-label="Current domain">@CurrentDomainName</summary>
                <form method="post" action="/domains/select">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                    @foreach (MonkeysphereDomain domain in Domains.Snapshot)
                    {
                        <button type="submit"
                                name="domainId"
                                value="@domain.Id"
                                class="@(domain.Id == CurrentDomain.Id ? "active" : null)"
                                aria-current="@(domain.Id == CurrentDomain.Id ? "true" : null)">
                            <span>@domain.Name</span>
                            @if (domain.Id == CurrentDomain.Id)
                            {
                                <span aria-hidden="true">✓</span>
                            }
                        </button>
                    }
                    <a href="/settings/domains">Manage domains</a>
                </form>
            </details>
        </Authorized>
    </AuthorizeView>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Use dark theme" aria-pressed="false" title="Use dark theme">
        <span data-theme-icon aria-hidden="true">☾</span>
    </button>
    <AuthorizeView>
        <Authorized>
            <form method="post" action="/auth/logout" class="logout-form">
                <AntiforgeryToken />
                <button type="submit" class="button-link">Sign out</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>

<main class="page-shell" id="main-content">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href=".">Reload</a>
</div>

@code {
    private string CurrentDomainName => Domains.TryGet(CurrentDomain.Id, out MonkeysphereDomain? domain)
        ? domain?.Name ?? "Default"
        : "Default";

    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        if (authentication.User.Identity?.IsAuthenticated == true &&
            !string.Equals(path, "setup", StringComparison.OrdinalIgnoreCase) &&
            !(await Presets.GetSetupStatusAsync()).IsComplete)
        {
            Navigation.NavigateTo("/setup");
        }
    }

}
