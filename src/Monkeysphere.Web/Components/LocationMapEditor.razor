@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="location-map" @ref="_element" role="img" aria-label="Coordinate map editor visualization" aria-describedby="@_helpId"></div>
<span id="@_helpId" class="muted">Click the map to set coordinates. This local graticule does not contact a tile or geocoding service.</span>

@code {
    [Parameter]
    public double? Latitude { get; set; }

    [Parameter]
    public double? Longitude { get; set; }

    [Parameter]
    public EventCallback<LocationPin> OnPinChanged { get; set; }

    private ElementReference _element;
    private readonly string _helpId = $"location-map-help-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<LocationMapEditor>? _reference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./map-editor.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _element, _reference, Latitude, Longitude);
        }
        else if (_module is not null)
        {
            await _module.InvokeVoidAsync("update", _element, Latitude, Longitude);
        }
    }

    [JSInvokable]
    public Task PinChanged(double latitude, double longitude) =>
        OnPinChanged.InvokeAsync(new LocationPin(latitude, longitude));

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }
}
