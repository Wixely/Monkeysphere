@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="spatial-map"
     @ref="_element"
     role="img"
     aria-label="Record location map visualization"
     aria-describedby="record-map-description"></div>
<p class="muted" id="record-map-description">Pins are clustered when close together. Select a pin or cluster to see its records, or browse the equivalent list below. No tile or geocoding service is contacted.</p>

<details class="map-record-list">
    <summary>Browse locations as a list (@Entries.Count)</summary>
    <div class="map-selection" aria-label="Locations on this map page">
        @foreach (SpatialMapEntry entry in Entries)
        {
            <article>
                <a href="/records/@entry.RecordId">@entry.RecordDisplayName</a>
                <span>@entry.RecordTypeName Â· @entry.FieldName</span>
                @if (!string.IsNullOrWhiteSpace(entry.DisplayContext))
                {
                    <small>@entry.DisplayContext</small>
                }
                @if (entry.ApproximationRadiusKilometres is double radius)
                {
                    <small>Approximation radius: @radius.ToString("0.####", CultureInfo.CurrentCulture) km</small>
                }
            </article>
        }
    </div>
</details>

@if (_selected.Count > 0)
{
    <div class="map-selection" aria-live="polite">
        @foreach (SpatialMapEntry entry in _selected)
        {
            <article>
                <a href="/records/@entry.RecordId">@entry.RecordDisplayName</a>
                <span>@entry.RecordTypeName · @entry.FieldName</span>
                @if (!string.IsNullOrWhiteSpace(entry.DisplayContext))
                {
                    <small>@entry.DisplayContext</small>
                }
                @if (entry.ApproximationRadiusKilometres is double radius)
                {
                    <small>Approximation radius: @radius.ToString("0.####", CultureInfo.CurrentCulture) km</small>
                }
            </article>
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<SpatialMapEntry> Entries { get; set; } = [];

    private ElementReference _element;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SpatialRecordMap>? _reference;
    private IReadOnlyList<SpatialMapEntry> _selected = [];
    private string _entryRevision = string.Empty;
    private bool _needsUpdate;

    protected override void OnParametersSet()
    {
        string revision = string.Join('|', Entries.Select(entry => entry.FieldValueId));
        _needsUpdate = !string.Equals(revision, _entryRevision, StringComparison.Ordinal);
        _entryRevision = revision;
        _selected = _selected.Where(selected => Entries.Any(entry => entry.FieldValueId == selected.FieldValueId)).ToArray();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./record-map.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("create", _element, _reference, Entries);
            _needsUpdate = false;
        }
        else if (_needsUpdate && _module is not null)
        {
            await _module.InvokeVoidAsync("update", _element, Entries);
            _needsUpdate = false;
        }
    }

    [JSInvokable]
    public Task ClusterSelected(string[] fieldValueIds)
    {
        HashSet<Guid> selectedIds = fieldValueIds
            .Select(value => Guid.TryParse(value, out Guid id) ? id : Guid.Empty)
            .Where(id => id != Guid.Empty)
            .ToHashSet();
        _selected = Entries.Where(entry => selectedIds.Contains(entry.FieldValueId)).ToArray();
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _element);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }
}
