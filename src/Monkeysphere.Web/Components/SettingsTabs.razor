@inject IConfiguration Configuration

<nav class="section-tabs settings-tabs" aria-label="Settings sections">
    <a class="@(Active == "domains" ? "active" : null)"
       aria-current="@(Active == "domains" ? "page" : null)"
       href="/settings/domains">Domains</a>
    <a class="@(Active == "dashboard" ? "active" : null)"
       aria-current="@(Active == "dashboard" ? "page" : null)"
       href="/settings/dashboard">Dashboard</a>
    <a class="@(Active == "map" ? "active" : null)"
       aria-current="@(Active == "map" ? "page" : null)"
       href="/settings/map">Map</a>
    <a class="@(Active == "graph" ? "active" : null)"
       aria-current="@(Active == "graph" ? "page" : null)"
       href="/settings/graph">Graph</a>
    <a class="@(Active == "import-export" ? "active" : null)"
       aria-current="@(Active == "import-export" ? "page" : null)"
       href="/settings">Import/export</a>
    <a class="@(Active == "backups" ? "active" : null)"
       aria-current="@(Active == "backups" ? "page" : null)"
       href="/settings/backups">Backups</a>
    <a class="@(Active == "remote-access" ? "active" : null)"
       aria-current="@(Active == "remote-access" ? "page" : null)"
       href="/settings/remote-access">Remote access</a>
    @if (DebugResetEnabled)
    {
        <a class="@(Active == "debug" ? "active" : null)"
           aria-current="@(Active == "debug" ? "page" : null)"
           href="/settings/debug">Debug</a>
    }
    <a class="@(Active == "about" ? "active" : null)"
       aria-current="@(Active == "about" ? "page" : null)"
       href="/settings/about">About</a>
</nav>

@code {
    [Parameter, EditorRequired]
    public string Active { get; set; } = string.Empty;

    private bool DebugResetEnabled => Configuration.GetValue<bool>("Monkeysphere:Debug:AllowDatabaseReset");
}
